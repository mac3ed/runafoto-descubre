                  <div class="glass" style="padding: 20px; border-radius: 12px; background: var(--surface-card); border: 1px solid var(--border-glass); box-shadow: var(--shadow-premium);">
                    <form method="POST" action="" style="display: flex; flex-direction: column; gap: 16px;">
                      <input type="hidden" name="action" value="create_campaign" />
                      
                      <div style="display: flex; flex-direction: column; gap: 6px;">
                        <label style="font-size: 12px; font-weight: 700; color: var(--text-main);">Nombre del Diagnóstico</label>
                        <input type="text" name="nombre" placeholder="Ej: Descubrimiento Q3 2026" required class="form-input glass" style="font-size: 13px; height: 38px; padding: 0 12px;" />
                      </div>
                      
                      <div style="display: flex; flex-direction: column; gap: 6px;">
                        <label style="font-size: 12px; font-weight: 700; color: var(--text-main);">Clonar estructura de anterior (Opcional)</label>
                        <select name="clonarHitoId" class="form-input glass" style="font-size: 13px; height: 38px; padding: 0 12px; font-weight: 600; cursor: pointer;">
                          <option value="none">-- Iniciar en blanco (Sin clonar) --</option>
                          {hitos.map(h => (
                            <option value={h.id}>{h.nombre}</option>
                          ))}
                        </select>
                        <span style="font-size: 11px; color: var(--text-muted); line-height: 1.3; display: block; margin-top: 2px;">Copia dimensiones, roles y preguntas sin incluir respuestas pasadas.</span>
                      </div>
                      
                      <button type="submit" class="btn-save" style="margin-top: 8px; font-weight: 700; height: 38px; display: inline-flex; align-items: center; justify-content: center; gap: 8px; cursor: pointer;">
                        <span>➕</span> Crear e Ingresar
                      </button>
                    </form>
                  </div>
                </div>
              </div>
            </div>
            <!-- 5. Resultados -->
            <div class="tab-content-panel" id="panel-resultados" style="display: none;">
              <!-- Sub-pestañas de Resultados -->
              <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 24px; border-bottom: 1px solid var(--border-glass); padding-bottom: 16px;">
                <div>
                  <h2 class="section-heading font-display" style="margin: 0; font-size: 17px; font-weight: 600; letter-spacing: -0.01em;">Panel Ejecutivo de Descubrimientos</h2>
                  <p style="font-size: 12.5px; color: var(--text-muted); margin: 4px 0 0 0;">Análisis estratégico e incidencias operacionales.</p>
                </div>
                <div class="segmented-control glass" style="display: flex; gap: 2px; padding: 2px; border-radius: 8px; background: rgba(0,0,0,0.03); border: 1px solid var(--border-glass);">
                  <button type="button" class="sub-tab-btn active" data-subtab="resumen" style="padding: 6px 14px; font-size: 12px; font-weight: 600; border-radius: 6px; border: none; background: transparent; color: var(--text-muted); cursor: pointer; transition: all 0.2s;">📊 Analíticas</button>
                  <button type="button" class="sub-tab-btn" data-subtab="comparativo" style="padding: 6px 14px; font-size: 12px; font-weight: 600; border-radius: 6px; border: none; background: transparent; color: var(--text-muted); cursor: pointer; transition: all 0.2s;">⚖️ Comparativo</button>
                  <button type="button" class="sub-tab-btn" data-subtab="cruces" style="padding: 6px 14px; font-size: 12px; font-weight: 600; border-radius: 6px; border: none; background: transparent; color: var(--text-muted); cursor: pointer; transition: all 0.2s;">🔍 Cruces y Análisis</button>
                  <button type="button" class="sub-tab-btn" data-subtab="trazabilidad" style="padding: 6px 14px; font-size: 12px; font-weight: 600; border-radius: 6px; border: none; background: transparent; color: var(--text-muted); cursor: pointer; transition: all 0.2s;">📋 Trazabilidad</button>
                </div>
              </div>

              <!-- Sub-pestaña: Analíticas -->
              <div class="sub-tab-panel" id="subpanel-resumen" style="display: block;">
              {/* Grid de Métricas Principales (KPI Cards) */}
              <section class="kpi-grid">
              <div class="kpi-card glass">
                <span class="kpi-title">TASA DE PARTICIPACIÓN</span>
                <div class="kpi-value-row">
                  <span class="kpi-value font-display">{participacionPorcentaje}%</span>
                  <span class="kpi-subtext">{asignacionesCompletadas} de {totalAsignaciones} Enlaces</span>
                </div>
                <div style="margin-top: 12px;">
                  <ProgressBar value={participacionPorcentaje} variant="thick" />
                </div>
              </div>

              <div class="kpi-card glass">
                <span class="kpi-title">RESPUESTAS REGISTRADAS</span>
                <div class="kpi-value-row">
                  <span class="kpi-value font-display">{totalRespuestas}</span>
                  <span class="kpi-subtext">Datos consolidados</span>
                </div>
              </div>

              <div class="kpi-card glass">
                <span class="kpi-title">COLABORADORES DE GRUPO</span>
                <div class="kpi-value-row">
                  <span class="kpi-value font-display">{colaboradoresGrupalesUnicos}</span>
                  <span class="kpi-subtext">Operativos en multienlaces</span>
                </div>
              </div>

              <div class="kpi-card glass alert-card">
                <span class="kpi-title alert-title">FUGAS DE VALOR DETECTADAS</span>
                <div class="kpi-value-row">
                  <span class="kpi-value font-display text-alert">{fugasDeValor.length}</span>
                  <span class="kpi-subtext">Alertas en flujo</span>
                </div>
              </div>
            </section>

            {/* Secciones de Analítica por Dimensión */}
            <h2 class="section-heading font-display">Dimensiones de Análisis ({dimensiones.length})</h2>
            <section class="dimensions-grid">
              {dimensiones.map(dim => {
                const respuestasDim = getRespuestasPorDimension(dim.id);
                const totalRespDim = respuestasDim.length;
                
                return (
                  <div class="dimension-card glass">
                    <div class="dim-header" style={`border-left: 4px solid ${dim.color || 'var(--primary-color)'}`}>
                      <div>
                        <span class="dim-code font-display">{dim.codigo}</span>
                        <h3 class="dim-name font-display">{dim.nombre}</h3>
                      </div>
                      <span class="dim-count">{totalRespDim} resp</span>
                    </div>
                    <p class="dim-desc">{dim.descripcion}</p>
                    
                    <div class="dim-answers-summary">
                      <span class="summary-title">Respuestas Recientes en Dimensión:</span>
                      {respuestasDim.length === 0 ? (
                        <p class="no-data">Sin respuestas registradas aún en esta dimensión.</p>
                      ) : (
                        <div class="mini-answers-list">
                          {respuestasDim.slice(0, 2).map(r => (
                            <div class="mini-answer-item">
                              <span class="role-badge">{r.cuestionario_nombre} ({r.identificador_sujeto})</span>
                              <p class="answer-text">
                                <strong>{r.pregunta_codigo}:</strong> {
                                  Array.isArray(r.valor?.respuesta) 
                                    ? r.valor.respuesta.join(' > ') 
                                    : String(r.valor?.respuesta ?? '')
                                }
                              </p>
                            </div>
                          ))}
                        </div>
                      )}
                    </div>
                  </div>
                );
              })}
            </section>

            {/* Fugas de Valor en Detalle (Alertas Críticas Rediseñadas) */}
            <h2 class="section-heading font-display text-alert">Alertas Críticas de Fuga de Valor ({fugasDeValor.length})</h2>
            <section class="alerts-section-redesigned" style="display: grid; grid-template-columns: repeat(auto-fit, minmax(320px, 1fr)); gap: 16px; margin-bottom: 36px;">
              {fugasDeValor.length === 0 ? (
                <div class="empty-alerts glass" style="grid-column: 1 / -1; display: flex; flex-direction: column; align-items: center; gap: 12px; padding: 32px; color: var(--text-muted); border-radius: 12px;">
                  <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="empty-icon" style="width: 36px; height: 36px; color: var(--success-color);"><circle cx="12" cy="12" r="10"></circle><path d="m9 12 2 2 4-4"></path></svg>
                  <p style="font-size: 13.5px; font-weight: 500;">No se han registrado respuestas que representen alertas de fugas de valor activas.</p>
                </div>
              ) : (
                fugasDeValor.map(f => (
                  <div class="alert-incidence-card glass" style="border: 1px solid hsla(330, 85%, 55%, 0.2); background: hsla(330, 85%, 55%, 0.03); border-radius: 12px; padding: 20px; display: flex; flex-direction: column; gap: 12px; position: relative; overflow: hidden; transition: all 0.2s;">
                    <div style="position: absolute; top: 0; left: 0; width: 4px; height: 100%; background: var(--accent-color);"></div>
                    <div style="display: flex; justify-content: space-between; align-items: center;">
                      <span class="alert-code font-display" style="background: hsla(330, 85%, 55%, 0.15); color: var(--accent-color); padding: 3px 8px; border-radius: 4px; font-weight: 700; font-size: 11px; letter-spacing: 0.5px;">{f.pregunta_codigo}</span>
                      <span style="font-size: 11px; font-weight: 700; color: white; background: var(--accent-color); padding: 2px 6px; border-radius: 4px; text-transform: uppercase;">Incidencia</span>
                    </div>
                    <div>
                      <p style="font-size: 13.5px; font-weight: 600; color: var(--text-main); margin-bottom: 4px; line-height: 1.3;">{f.pregunta_texto}</p>
                      <span style="font-size: 12px; color: var(--text-muted); font-weight: 500;">Reportado por: <strong>{f.cuestionario_nombre} ({f.identificador_sujeto})</strong></span>
                    </div>
                    <div style="background: rgba(0,0,0,0.15); padding: 10px 12px; border-radius: 6px; border: 1px solid var(--border-glass);">
                      <span style="font-size: 10px; color: var(--text-muted); display: block; margin-bottom: 2px; text-transform: uppercase; font-weight: 600;">Respuesta Crítica:</span>
                      <p style="font-size: 13px; font-weight: 700; color: var(--accent-color); margin: 0; line-height: 1.3;">
                        {
                          Array.isArray(f.valor?.respuesta)
                            ? f.valor.respuesta.join(' > ')
                            : String(f.valor?.respuesta ?? '')
                        }
                      </p>
                    </div>
                  </div>
                ))
              )}
            </section>

            {/* Sección de Auditoría de Terminales (WiFi Compartido) al final de Analíticas */}
            <div class="audit-summary-wrapper" style="margin-top: 36px;">
              {alertasFraude.length === 0 ? (
                <div class="audit-summary-card success-status glass" style="padding: 16px 20px; border-radius: 12px; border: 1px solid rgba(16, 185, 129, 0.2); background: rgba(16, 185, 129, 0.02); display: flex; align-items: center; justify-content: space-between; gap: 16px; flex-wrap: wrap;">
                  <div style="display: flex; align-items: center; gap: 12px;">
                    <span style="font-size: 20px; line-height: 1;">✅</span>
                    <div>
                      <h4 style="margin: 0; font-size: 13.5px; font-weight: 700; color: #10b981;">Integridad de Respuestas (Auditoría de Dispositivos)</h4>
                      <p style="margin: 4px 0 0 0; font-size: 12px; color: var(--text-muted); line-height: 1.4;">Todos los envíos registrados corresponden a dispositivos individuales únicos. No hay sospechas de duplicidad.</p>
                    </div>
                  </div>
                </div>
              ) : (
                <div class="audit-summary-card alert-status glass" style="padding: 20px; border-radius: 12px; border: 1px solid rgba(225, 29, 72, 0.2); background: rgba(225, 29, 72, 0.02); display: flex; flex-direction: column; gap: 16px;">
                  <div style="display: flex; align-items: flex-start; gap: 12px;">
                    <span style="font-size: 24px; line-height: 1;">⚠️</span>
                    <div>
                      <h4 style="margin: 0; font-size: 14px; font-weight: 700; color: var(--accent-color);">Alerta de Integridad de Datos (Dispositivo Compartido)</h4>
                      <p style="margin: 4px 0 0 0; font-size: 12.5px; color: var(--text-muted); line-height: 1.4;">Se han detectado múltiples cuestionarios completados desde el mismo dispositivo físico. Esto podría indicar que se compartió el terminal o se repitieron envíos.</p>
                    </div>
                  </div>
                  <div class="table-responsive" style="margin-top: 8px;">
                    <table class="audit-table" style="width: 100%; border-collapse: collapse; font-size: 13px;">
                      <thead>
                        <tr style="border-bottom: 1px solid var(--border-glass); text-align: left;">
                          <th style="padding: 8px 12px; color: var(--text-muted); font-weight: 600;">Huella del Dispositivo</th>
                          <th style="padding: 8px 12px; color: var(--text-muted); font-weight: 600;">Cuestionarios Afectados</th>
                          <th style="padding: 8px 12px; color: var(--text-muted); font-weight: 600;">Colaboradores/Sesiones</th>
                          <th style="padding: 8px 12px; color: var(--text-muted); font-weight: 600;">Total Envíos</th>
                        </tr>
                      </thead>
                      <tbody>
                        {alertasFraude.map(alert => (
                          <tr class="alert-row" style="border-bottom: 1px solid rgba(0,0,0,0.03);">
                            <td style="padding: 10px 12px;"><code class="device-code" style="background: rgba(0,0,0,0.05); padding: 2px 6px; border-radius: 4px; font-family: monospace; font-size: 11px;">{alert.deviceId.substring(0, 12)}... ({alert.fingerprint})</code></td>
                            <td style="padding: 10px 12px;">{Array.from(alert.cuestionarios).join(', ')}</td>
                            <td style="padding: 10px 12px;" class="alert-subjects">
                              {Array.from(alert.envios).map(env => (
                                <span class="subject-badge" style="display: inline-block; background: rgba(0,0,0,0.05); padding: 2px 6px; border-radius: 4px; margin-right: 4px; font-size: 11px; font-weight: 600;">{env}</span>
                              ))}
                            </td>
                            <td style="padding: 10px 12px;"><strong>{alert.totalResp} respuestas</strong></td>
                          </tr>
                         ))}
                       </tbody>
                     </table>
                   </div>
                   <div style="text-align: right; margin-top: 8px;">
                     <button type="button" class="btn-preview-link" onclick="document.querySelector('.sub-tab-btn[data-subtab=trazabilidad]').click()" style="padding: 6px 14px; font-size: 12px; border-radius: 6px; cursor: pointer; display: inline-flex; align-items: center; gap: 4px; border: 1px solid var(--border-glass); background: transparent; color: var(--text-main); font-weight: 600; transition: all 0.2s;">Investigar en Trazabilidad →</button>
                   </div>
                 </div>
               )}
             </div>
            </div> <!-- Closes subpanel-resumen -->
            </div> <!-- Closes panel-resultados -->

            <!-- 2. Dimensiones de Análisis -->
            <div class="tab-content-panel" id="panel-dimensiones" style="display: none;">
              <h2 class="section-heading font-display">Definir Dimensiones de Análisis</h2>
              <p class="description-helper" style="font-size: 13px; color: var(--text-muted); margin-bottom: 24px; line-height: 1.4;">
                Las dimensiones agrupan las hipótesis y las preguntas estratégicas del diagnóstico para la campaña "<strong>{activeHito?.nombre}</strong>".
              </p>

              <div class="layout-grid-sidebar">
                <!-- Listado de Dimensiones con Edición Inline -->
                <div class="glass" style="padding: 24px; border-radius: 12px; background: var(--surface-card); border: 1px solid var(--border-glass);">
                  <h3 class="pane-title font-display" style="font-size: 15px; margin: 0 0 16px 0; padding-bottom: 8px; border-bottom: 1px solid var(--border-glass);">Dimensiones Registradas ({dimensiones.length})</h3>
                  {dimensiones.length === 0 ? (
                    <p style="font-size: 13px; color: var(--text-muted); font-style: italic; text-align: center; padding: 24px;">No hay dimensiones creadas para esta campaña.</p>
                  ) : (
                    <div style="display: grid; grid-template-columns: repeat(auto-fill, minmax(280px, 1fr)); gap: 16px;">
                      {dimensiones.map(d => (
                        <div class="dimension-card-item glass" id={`dim-container-${d.id}`} style={`padding: 16px; border-radius: 8px; border: 1px solid var(--border-glass); border-left: 5px solid ${d.color}; display: flex; flex-direction: column; justify-content: space-between; gap: 12px; min-height: 120px; transition: all 0.2s; background: #ffffff;`}>
                          <!-- Modo Visualización -->
                          <div id={`dim-view-${d.id}`} style="display: flex; flex-direction: column; gap: 4px;">
                            <div style="display: flex; justify-content: space-between; align-items: baseline;">
                              <span class="font-display" style="font-weight: 600; font-size: 11.5px; background: rgba(0,0,0,0.04); padding: 2px 6px; border-radius: 4px; color: var(--text-main);">{d.codigo}</span>
                              <span style="font-size: 11px; color: var(--text-muted); font-weight: 500;">{d.color}</span>
                            </div>
                            <strong style="font-size: 13.5px; color: var(--text-main); margin-top: 4px; display: block;">{d.nombre}</strong>
                            <p style="font-size: 12.5px; color: var(--text-muted); margin: 4px 0 0 0; line-height: 1.3;">{d.descripcion}</p>
                            
                            <div style="display: flex; gap: 6px; margin-top: 12px;">
                              <button type="button" class="btn-edit-dim-trigger btn-preview-link" data-id={d.id} data-codigo={d.codigo} data-nombre={d.nombre} data-descripcion={d.descripcion} data-color={d.color} style="padding: 4px 8px; font-size: 11.5px; border-radius: 4px; font-weight: 700; cursor: pointer; height: auto;">Editar</button>
                              <form method="POST" action="" onsubmit="return confirm('¿Estás seguro de que deseas eliminar esta dimensión? No podrá eliminarse si tiene preguntas asociadas.');" style="margin: 0;">
                                <input type="hidden" name="action" value="delete_dimension" />
                                <input type="hidden" name="id" value={d.id} />
                                <button type="submit" style="padding: 4px 8px; font-size: 11.5px; border-radius: 4px; font-weight: 700; cursor: pointer; height: auto; background: rgba(225,29,72,0.06); color: var(--accent-color); border: 1px solid rgba(225,29,72,0.15);">Borrar</button>
                              </form>
                            </div>
                          </div>

                          <!-- Modo Edición Inline -->
                          <form method="POST" action="" id={`dim-edit-form-${d.id}`} style="display: none; flex-direction: column; gap: 10px; margin: 0;">
                            <input type="hidden" name="action" value="update_dimension" />
                            <input type="hidden" name="id" value={d.id} />
                            
                            <div style="display: grid; grid-template-columns: 80px 1fr; gap: 8px;">
                              <input type="text" name="codigo" value={d.codigo} required placeholder="Código" class="form-input glass" style="font-size: 12px; height: 32px; padding: 0 8px; font-weight: 700;" />
                              <input type="text" name="nombre" value={d.nombre} required placeholder="Nombre" class="form-input glass" style="font-size: 12px; height: 32px; padding: 0 8px; font-weight: 700;" />
                            </div>
                            
                            <textarea name="descripcion" required placeholder="Descripción de la Dimensión" class="form-input glass" style="font-size: 12px; padding: 8px; height: 60px; resize: none; line-height: 1.3; font-family: inherit;">{d.descripcion}</textarea>
                            
                            <div style="display: grid; grid-template-columns: 1fr 80px; gap: 8px; align-items: center;">
                              <input type="text" name="color" value={d.color} placeholder="Color (Hex/HSL)" class="form-input glass" style="font-size: 12px; height: 32px; padding: 0 8px;" />
                              <div style="display: flex; gap: 4px;">
                                <button type="submit" class="btn-save" style="flex: 1; height: 32px; font-size: 11.5px; padding: 0; font-weight: 700; cursor: pointer;">✓</button>
                                <button type="button" class="btn-edit-dim-cancel btn-preview-link" data-id={d.id} style="flex: 1; height: 32px; font-size: 11.5px; padding: 0; font-weight: 700; cursor: pointer;">✕</button>
                              </div>
                            </div>
                          </form>
                        </div>
                      ))}
                    </div>
                  )}
                </div>

                <!-- Formulario de Creación de Dimensión -->
                <div class="glass" style="padding: 20px; border-radius: 12px; background: var(--surface-card); border: 1px solid var(--border-glass);">
                  <h3 class="pane-title font-display" style="font-size: 15px; margin: 0 0 16px 0; padding-bottom: 8px; border-bottom: 1px solid var(--border-glass);">Añadir Dimensión</h3>
                  <form method="POST" action="" style="display: flex; flex-direction: column; gap: 14px;">
                    <input type="hidden" name="action" value="create_dimension" />
                    
                    <div style="display: grid; grid-template-columns: 80px 1fr; gap: 8px;">
                      <div style="display: flex; flex-direction: column; gap: 4px;">
                        <label style="font-size: 11px; font-weight: 700; color: var(--text-muted);">Código</label>
                        <input type="text" name="codigo" placeholder="Ej: D1" required class="form-input glass" style="font-size: 12.5px; height: 34px; padding: 0 8px; font-weight: 700;" />
                      </div>
                      <div style="display: flex; flex-direction: column; gap: 4px;">
                        <label style="font-size: 11px; font-weight: 700; color: var(--text-muted);">Nombre</label>
                        <input type="text" name="nombre" placeholder="Ej: Cultura" required class="form-input glass" style="font-size: 12.5px; height: 34px; padding: 0 8px; font-weight: 700;" />
                      </div>
                    </div>
                    
                    <div style="display: flex; flex-direction: column; gap: 4px;">
                      <label style="font-size: 11px; font-weight: 700; color: var(--text-muted);">Descripción / Hipótesis</label>
                      <textarea name="descripcion" placeholder="Describe qué busca diagnosticar esta dimensión." required class="form-input glass" style="font-size: 12.5px; padding: 8px; height: 70px; resize: none; line-height: 1.3; font-family: inherit;"></textarea>
                    </div>
                    
                    <div style="display: flex; flex-direction: column; gap: 4px;">
                      <label style="font-size: 11px; font-weight: 700; color: var(--text-muted);">Color Representativo</label>
                      <div style="display: flex; gap: 8px; align-items: center;">
                        <input type="text" name="color" id="dim-new-color-input" placeholder="Ej: hsl(24, 90%, 55%)" required class="form-input glass" style="font-size: 12.5px; height: 34px; padding: 0 8px; flex: 1;" />
                        <input type="color" id="dim-new-color-picker" style="width: 34px; height: 34px; padding: 0; border: 1px solid var(--border-glass); border-radius: 6px; cursor: pointer; background: transparent;" value="#0e7490" />
                      </div>
                    </div>
                    
                    <button type="submit" class="btn-save" style="margin-top: 6px; font-weight: 700; height: 36px; display: inline-flex; align-items: center; justify-content: center; gap: 6px; cursor: pointer;">
                      <span>➕</span> Guardar Dimensión
                    </button>
                  </form>
                </div>
              </div>
            </div>

            <!-- 3. Roles y Preguntas -->
            <div class="tab-content-panel" id="panel-roles" style="display: none;">
              <h2 class="section-heading font-display">Crear Roles y Diseñar Preguntas</h2>
              <p class="description-helper" style="font-size: 13px; color: var(--text-muted); margin-bottom: 24px; line-height: 1.4;">
                Los roles representan los perfiles a evaluar en la campaña "<strong>{activeHito?.nombre}</strong>". Cada rol contiene sus propias preguntas en el constructor interactivo.
              </p>

              <div class="layout-grid-roles">
                <!-- Columna Izquierda: Roles / Departamentos -->
                <div>
                  <h3 class="pane-title font-display" style="font-size: 14.5px; margin: 0 0 12px 0;">Roles a Evaluar ({cuestionarios.length})</h3>
                  
                  <!-- Formulario Inline de creación rápida de Rol -->
                  <form method="POST" action="" style="display: flex; gap: 6px; margin-bottom: 16px;">
                    <input type="hidden" name="action" value="create_questionnaire" />
                    <input type="hidden" name="hitoId" value={activeHitoId} />
                    <input type="hidden" name="descripcion" value={`Diagnóstico del rol en la campaña ${activeHito?.nombre}`} />
                    <input type="text" name="nombre" placeholder="Nuevo Rol (ej: Ventas)" required class="form-input glass" style="font-size: 12.5px; height: 34px; padding: 0 10px; flex: 1; font-weight: 600;" />
                    <button type="submit" class="btn-save" style="width: 34px; height: 34px; padding: 0; font-size: 12px; display: inline-flex; align-items: center; justify-content: center; font-weight: 700; cursor: pointer;">➕</button>
                  </form>

                  {cuestionarios.length === 0 ? (
                    <p style="font-size: 12.5px; color: var(--text-muted); font-style: italic;">No hay roles creados.</p>
                  ) : (
                    <div style="display: flex; flex-direction: column; gap: 8px;">
                      {cuestionarios.map(c => {
                        const isSelected = c.id === selectCuestionarioId;
                        return (
                          <div 
                            style={`display: flex; justify-content: space-between; align-items: center; padding: 10px 12px; border-radius: 8px; background: ${isSelected ? 'rgba(14,116,144,0.03)' : 'rgba(0,0,0,0.01)'}; border: ${isSelected ? '2px solid var(--primary-color)' : '1px solid var(--border-glass)'}; box-shadow: ${isSelected ? 'var(--shadow-premium)' : 'none'}; transition: all 0.2s; position: relative;`}
                            class="role-card-wrapper"
                          >
                            <a 
                              href={`/administrador?hitoId=${activeHitoId}&tab=roles&select_cuestionario_id=${c.id}`} 
                              style="flex: 1; text-decoration: none; cursor: pointer;"
                            >
                              <strong style="font-size: 13px; color: var(--text-main); display: block;">{c.nombre}</strong>
                              <span style="font-size: 11px; color: var(--text-muted); display: block; margin-top: 2px;">{todasLasPreguntas.filter(p => p.cuestionario_id === c.id).length} preguntas</span>
                            </a>
                            
                            <!-- Borrado de Rol -->
                            <form method="POST" action="" onsubmit="return confirm('¿Eliminar este rol y todas sus preguntas?');" style="margin: 0; display: inline-flex;">
                              <input type="hidden" name="action" value="delete_questionnaire" />
                              <input type="hidden" name="id" value={c.id} />
                              <button type="submit" style="background: transparent; border: none; color: var(--text-muted); font-size: 14px; cursor: pointer; padding: 4px; display: inline-flex; align-items: center; justify-content: center; font-weight: 700;">✕</button>
                            </form>
                          </div>
                        );
                      })}
                    </div>
                  )}
                </div>

                <!-- Columna Derecha: Constructor de Preguntas del Rol seleccionado -->
                <div>
                  {!selectCuestionarioId ? (
                    <div class="glass" style="padding: 32px; text-align: center; color: var(--text-muted); border-radius: 12px;">
                      <p style="font-size: 13.5px; font-weight: 500; margin: 0;">Selecciona o crea un rol a la izquierda para diseñar su estructura de preguntas.</p>
                    </div>
                  ) : (
                    <div class="glass" style="padding: 24px; border-radius: 12px; border: 1px solid var(--border-glass); background: #ffffff;">
                      <h3 class="font-display" style="font-size: 15.5px; font-weight: 700; color: var(--text-main); margin: 0 0 16px 0; border-bottom: 1px solid var(--border-glass); padding-bottom: 8px;">
                        🛠️ Estructurador de Preguntas: {selectedCuestionario?.nombre}
                      </h3>

                      <div class="layout-grid-builder">
                        <!-- Formulario de Pregunta Inline -->
                        <div class="glass" style="padding: 16px; border-radius: 8px; border: 1px solid var(--border-glass); background: rgba(0,0,0,0.01);">
                          <strong id="form-question-title" style="font-size: 12.5px; display: block; margin-bottom: 12px; color: var(--text-main);">Añadir Pregunta</strong>
                          <form id="form-question" method="POST" action="" style="display: flex; flex-direction: column; gap: 12px;">
                            <input type="hidden" name="action" id="q-action" value="create_question" />
                            <input type="hidden" name="id" id="q-id" value="" />
                            <input type="hidden" name="cuestionario_id" value={selectCuestionarioId} />
                            
                            <div style="display: grid; grid-template-columns: 100px 1fr; gap: 8px;">
                              <div style="display: flex; flex-direction: column; gap: 4px;">
                                <label style="font-size: 11px; font-weight: 700; color: var(--text-muted);">Código</label>
                                <input type="text" name="codigo" id="q-codigo" required placeholder="Ej: DIR_01" class="form-input glass" style="font-size: 12.5px; height: 34px; padding: 0 8px; font-weight: 700;" />
                              </div>
                              <div style="display: flex; flex-direction: column; gap: 4px;">
                                <label style="font-size: 11px; font-weight: 700; color: var(--text-muted);">Tipo de Control</label>
                                <select name="tipo" id="q-input-tipo" required class="form-input glass" style="font-size: 12.5px; height: 34px; padding: 0 8px; font-weight: 600; cursor: pointer;">
                                  <option value="OPCION_MULTIPLE">Opción Múltiple</option>
                                  <option value="ORDEN">Ordenación (Drag)</option>
                                  <option value="CORTA">Respuesta Corta</option>
                                  <option value="BOOLEAN">Booleano (Sí/No)</option>
                                  <option value="ESCALA">Escala (1 a 5)</option>
                                  <option value="NUMERO">Número</option>
                                  <option value="FECHA">Fecha</option>
                                </select>
                              </div>
                            </div>
                            
                            <div style="display: flex; flex-direction: column; gap: 4px;">
                              <label style="font-size: 11px; font-weight: 700; color: var(--text-muted);">Dimensión de Análisis</label>
                              <select name="dimension_id" id="q-dimension" required class="form-input glass" style="font-size: 12.5px; height: 34px; padding: 0 8px; font-weight: 600; cursor: pointer;">
                                <option value="" disabled selected>-- Seleccionar Dimensión --</option>
                                {dimensiones.map(d => (
                                  <option value={d.id}>{d.codigo} - {d.nombre}</option>
                                ))}
                              </select>
                            </div>
                            
                            <div style="display: flex; flex-direction: column; gap: 4px;">
                              <label style="font-size: 11px; font-weight: 700; color: var(--text-muted);">Enunciado / Pregunta</label>
                              <textarea name="texto" id="q-texto" required placeholder="Escribe el enunciado de la pregunta aquí..." class="form-input glass" style="font-size: 12.5px; padding: 8px; height: 60px; resize: none; line-height: 1.3; font-family: inherit;"></textarea>
                            </div>
                            
                            <div style="display: flex; flex-direction: column; gap: 4px;" id="q-opciones-group">
                              <label style="font-size: 11px; font-weight: 700; color: var(--text-muted);">Opciones de Respuesta</label>
                              <input type="text" name="opciones" id="q-input-opciones" placeholder="Separadas por comas. Ej: Bueno, Regular, Malo" class="form-input glass" style="font-size: 12.5px; height: 34px; padding: 0 8px;" />
                            </div>

                            <!-- Respuesta Crítica Dinámica por Radio (Stripe-like) -->
                            <div style="display: flex; flex-direction: column; gap: 4px;">
                              <label style="font-size: 11px; font-weight: 700; color: var(--text-muted);">Respuesta Crítica (Alerta de Fricción)</label>
                              <input type="hidden" name="respuesta_critica" id="q-input-critica" value="" />
                              <div id="critical-options-container" style="display: flex; flex-direction: column; gap: 6px; padding: 8px; border: 1px solid var(--border-glass); border-radius: 6px; background: rgba(0,0,0,0.01); max-height: 120px; overflow-y: auto;">
                                <span style="font-size: 11.5px; color: var(--text-muted); font-style: italic;">Escribe opciones de respuesta arriba...</span>
                              </div>
                            </div>
                            
                            <div style="display: flex; gap: 6px; margin-top: 8px;">
                              <button type="submit" id="q-btn-submit" class="btn-save" style="flex: 1; font-weight: 700; height: 36px; cursor: pointer;">Guardar Pregunta</button>
                              <button type="button" id="q-btn-cancel" class="btn-preview-link" style="display: none; padding: 0 12px; font-size: 12px; border-radius: 6px; font-weight: 600; cursor: pointer; height: 36px; background: rgba(0,0,0,0.03); color: var(--text-main); border: 1px solid var(--border-glass);">Cancelar</button>
                            </div>
                          </form>
                        </div>

                        <!-- Listado de Preguntas del Cuestionario -->
                        <div>
                          <strong style="font-size: 12.5px; display: block; margin-bottom: 12px; color: var(--text-main);">Preguntas del Rol ({cuestionarioPreguntas.length})</strong>
                          {cuestionarioPreguntas.length === 0 ? (
                            <p style="font-size: 13px; color: var(--text-muted); font-style: italic; padding: 24px; text-align: center;" class="glass">No hay preguntas agregadas a este rol.</p>
                          ) : (
                            <div style="display: flex; flex-direction: column; gap: 10px; max-height: 480px; overflow-y: auto; padding-right: 4px;" id="questions-sortable-list">
                              {cuestionarioPreguntas.map(p => {
                                const dim = dimensiones.find(d => d.id === p.dimension_id);
                                const dimLabel = dim ? `${dim.codigo} - ${dim.nombre}` : p.dimension_id;
                                return (
                                  <div class="question-list-card glass" data-id={p.id} style="padding: 12px 14px; border-radius: 8px; border: 1px solid var(--border-glass); display: flex; justify-content: space-between; align-items: center; gap: 12px; background: #ffffff; transition: transform 0.2s;">
                                    <div style="display: flex; flex-direction: column; gap: 4px; flex: 1;">
                                      <div style="display: flex; align-items: center; gap: 8px; flex-wrap: wrap;">
                                        <span class="font-display" style="font-size: 10.5px; font-weight: 700; background: rgba(0,0,0,0.06); padding: 2px 6px; border-radius: 4px; color: var(--text-main);">{p.codigo}</span>
                                        <span style="font-size: 11px; color: var(--text-muted); font-weight: 600;">Dimensión: {dimLabel}</span>
                                        <span style="font-size: 10.5px; color: var(--text-muted); background: rgba(0,0,0,0.03); padding: 2px 6px; border-radius: 4px;">{p.tipo}</span>
                                      </div>
                                      <p style="margin: 0; font-size: 13px; font-weight: 600; color: var(--text-main); line-height: 1.4;">{p.texto}</p>
                                      {safeParseOptions(p.opciones).length > 0 && (
                                        <div style="font-size: 11.5px; color: var(--text-muted);">
                                          <strong>Opciones:</strong> {safeParseOptions(p.opciones).join(', ')}
                                        </div>
                                      )}
                                      {p.respuesta_critica && (
                                        <div style="font-size: 11.5px; color: var(--accent-color); font-weight: 700; display: inline-flex; align-items: center; gap: 4px; margin-top: 2px;">
                                          <span>⚠️ Alerta de Fricción:</span>
                                          <span style="background: rgba(225,29,72,0.05); padding: 1px 6px; border-radius: 3px; border: 1px dashed rgba(225,29,72,0.2);">{p.respuesta_critica}</span>
                                        </div>
                                      )}
                                    </div>
                                    <div style="display: flex; gap: 6px; align-items: center;">
                                      <button type="button" class="btn-edit-question btn-preview-link" data-id={p.id} data-codigo={p.codigo} data-tipo={p.tipo} data-texto={p.texto} data-dimension={p.dimension_id} data-opciones={safeParseOptions(p.opciones).join(', ')} data-critica={p.respuesta_critica || ''} style="padding: 4px 8px; font-size: 11.5px; font-weight: 700; border-radius: 4px; cursor: pointer; height: auto;">Editar</button>
                                      <form method="POST" action="" onsubmit="return confirm('¿Estás seguro de que deseas eliminar esta pregunta de manera permanente?');" style="margin: 0;">
                                        <input type="hidden" name="action" value="delete_question" />
                                        <input type="hidden" name="id" value={p.id} />
                                        <button type="submit" style="padding: 4px 8px; font-size: 11.5px; font-weight: 700; border-radius: 4px; cursor: pointer; height: auto; background: rgba(225,29,72,0.06); color: var(--accent-color); border: 1px solid rgba(225,29,72,0.15);">Borrar</button>
                                      </form>
                                    </div>
                                  </div>
                                );
                              })}
                            </div>
                          )}
                        </div>
                      </div>
                    </div>
                  )}
                </div>
              </div>

              <!-- Scripts JSON con datos seguros para el script interactivo del cliente -->
              <script id="todas-las-preguntas-data" type="application/json" is:inline set:html={JSON.stringify(todasLasPreguntas)}></script>
              <script id="dimensiones-data" type="application/json" is:inline set:html={JSON.stringify(dimensiones)}></script>
            </div>

            <div class="tab-content-panel" id="panel-lanzamiento" style="display: none;">
            {/* Centro de Control de Cuestionarios Activos (SaaS Table) */}
            <h2 class="section-heading font-display">Lanzamiento y Distribución de Enlaces</h2>
            <section class="control-table-section glass" style="margin-bottom: 36px; padding: 24px; border-radius: 12px;">
              <p class="description-helper" style="font-size: 13.5px; color: var(--text-muted); margin-bottom: 20px; line-height: 1.4;">
                Monitorea el progreso de participación y estados de lanzamiento de cada enlace de evaluación activo. 
                Haz clic en <strong>Administrar</strong> para configurar sus preguntas base o editar sus accesos.
              </p>
              
              {asignaciones.length === 0 ? (
                <p class="no-data-large" style="text-align: center; padding: 32px; color: var(--text-muted);">No hay enlaces de acceso creados actualmente.</p>
              ) : (
                <div class="table-responsive">
                  <table class="control-table" style="width: 100%; border-collapse: collapse; text-align: left; font-size: 13.5px;">
                    <thead>
                      <tr style="border-bottom: 1px solid var(--border-glass);">
                        <th style="padding: 12px; color: var(--text-muted); font-weight: 600; text-transform: uppercase; font-size: 11px; letter-spacing: 0.5px;">Audiencia / Destinatario</th>
                        <th style="padding: 12px; color: var(--text-muted); font-weight: 600; text-transform: uppercase; font-size: 11px; letter-spacing: 0.5px;">Cuestionario</th>
                        <th style="padding: 12px; color: var(--text-muted); font-weight: 600; text-transform: uppercase; font-size: 11px; letter-spacing: 0.5px;">Estado</th>
                        <th style="padding: 12px; color: var(--text-muted); font-weight: 600; text-transform: uppercase; font-size: 11px; letter-spacing: 0.5px;">Respuestas / Avance</th>
                        <th style="padding: 12px; color: var(--text-muted); font-weight: 600; text-transform: uppercase; font-size: 11px; letter-spacing: 0.5px; text-align: right;">Acciones</th>
                      </tr>
                    </thead>
                    <tbody>
                      {asignaciones.map(a => {
                        // Calcular porcentaje de cobertura de la muestra
                        let cobertura = 0;
                        let completados = 0;
                        if (a.tipo_sujeto === 'INDIVIDUAL') {
                          completados = a.completado_en ? 1: 0;
                          cobertura = a.completado_en ? 100 : 0;
                        } else {
                          const respuestasDeEsteCuestionario = respuestasRaw.filter(r => r.asignacion_id === a.id);
                          const sesionesDeEsteCuestionario = new Set(respuestasDeEsteCuestionario.map(r => r.valor?.sesionId).filter(Boolean));
                          completados = sesionesDeEsteCuestionario.size;
                          cobertura = a.muestra_esperada > 0 ? Math.min(100, Math.round((completados / a.muestra_esperada) * 100)) : 0;
                        }

                        return (
                          <tr class="control-row" style="border-bottom: 1px solid var(--border-glass); transition: background-color 0.2s;">
                            <td style="padding: 14px 12px; font-weight: 700; color: var(--text-main);">{a.identificador_sujeto}</td>
                            <td style="padding: 14px 12px; color: var(--text-muted);">{a.cuestionario_nombre}</td>
                            <td style="padding: 14px 12px;">
                              {a.estado === 'BORRADOR' && <span class="badge-status-item draft">Borrador</span>}
                              {a.estado === 'TEST' && <span class="badge-status-item test">🧪 Test</span>}
                              {a.estado === 'LANZADO' && <span class="badge-status-item live">🚀 Lanzado</span>}
                              {a.estado === 'COMPLETADO' && <span class="badge-status-item success" style="background: hsla(150, 80%, 40%, 0.15); color: var(--success-color); border: 1px solid hsla(150, 80%, 40%, 0.2); padding: 2px 6px; border-radius: 4px; font-weight: 700; font-size: 11px;">✅ Completado</span>}
                            </td>
                            <td style="padding: 14px 12px;">
                              <div style="display: flex; align-items: center; gap: 10px; width: 180px;">
                                <span style="font-weight: 600; min-width: 50px; font-size: 12.5px;">{cobertura}% ({completados}/{a.muestra_esperada})</span>
                                <div style="flex: 1; height: 6px; background: rgba(255,255,255,0.06); border-radius: 999px; overflow: hidden;">
                                  <div style={`width: ${cobertura}%; height: 100%; background: ${cobertura === 100 ? 'var(--success-color)' : 'var(--primary-color)'}; border-radius: 999px;`}></div>
                                </div>
                              </div>
                            </td>
                            <td style="padding: 14px 12px; text-align: right;">
                              <a href={`/administrador?hitoId=${activeHitoId}&tab=lanzamiento&admin_enlace_id=${a.id}`} class="btn-preview-link" style="padding: 6px 12px; font-size: 12px; border-radius: 6px; display: inline-flex;">Administrar →</a>
                            </td>
                          </tr>
                        );
                      })}
                    </tbody>
                  </table>
                </div>
              )}
            </section>

            {/* Banners de Estado POST */}
            {postSuccess && (
              <div class="banner-alert success-banner">
                <span class="icon">✅</span>
                <div class="message">{postSuccess}</div>
              </div>
            )}
            {postError && (
              <div class="banner-alert error-banner">
                <span class="icon">⚠️</span>
                <div class="message">{postError}</div>
              </div>
            )}

            {/* Panel de Gestión de Enlaces Activos */}
            <h2 class="section-heading font-display">Crear Nuevo Enlace de Encuesta</h2>
            <section class="management-section glass" style="max-width: 680px; margin: 0 auto 36px auto;">
              <div class="mgmt-card create-card" style="width: 100%;">
                <p class="description-helper" style="font-size: 13.5px; color: var(--text-muted); margin-bottom: 20px; line-height: 1.5;">
                  Genera un enlace web personalizado para compartir con <strong>alumnos, colaboradores o clientes</strong>. 
                  Si la encuesta es abierta para que participen muchas personas, elige la opción <strong>Grupal / Masiva</strong>.
                </p>
                <form method="POST" class="mgmt-form">
                  <input type="hidden" name="action" value="create_assignment" />
                  <input type="hidden" name="hitoId" value={activeHitoId} />
                  
                  <div class="form-group">
                    <label for="cuestionarioId" style="font-weight: 600; font-size: 13.5px;">Cuestionario / Plantilla a Aplicar:</label>
                    <select name="cuestionarioId" required class="form-input glass" style="width: 100%; margin: 0;">
                      {cuestionarios.map(c => (
                        <option value={c.id} selected={c.id === selectCuestionarioId}>{c.nombre}</option>
                      ))}
                    </select>
                  </div>

                  <div class="form-group">
                    <label for="identificadorSujeto" style="font-weight: 600; font-size: 13.5px;">Audiencia o Destinatario (Identificador):</label>
                    <input type="text" name="identificadorSujeto" placeholder="Ej: Alumnos Escuela RunaFoto, Douglas (Dirección), Clientes Bodas" required class="form-input glass" />
                    <span style="font-size: 11.5px; color: var(--text-muted); display: block; margin-top: 4px;">Nombre descriptivo que aparecerá en los reportes y estadísticas.</span>
                  </div>

                  <div class="form-row-2">
                    <div class="form-group">
                      <label for="tipoSujeto" style="font-weight: 600; font-size: 13.5px;">Modalidad de Enlace:</label>
                      <select name="tipoSujeto" class="form-input glass" id="new-tipo-sujeto" onchange="
                        const isGrupal = this.value === 'GRUPAL';
                        const inputMuestra = document.getElementById('new-muestra-esperada');
                        const helper = document.getElementById('muestra-helper-txt');
                        if (isGrupal) {
                          inputMuestra.value = '5000';
                          if (helper) helper.innerText = 'Capacidad abierta: permite miles de respuestas simultáneas.';
                        } else {
                          inputMuestra.value = '1';
                          if (helper) helper.innerText = 'Enlace personal único: se cierra al finalizar 1 respuesta.';
                        }
                      ">
                        <option value="GRUPAL" selected>👥 Grupal / Masivo (1 enlace para múltiples alumnos o público)</option>
                        <option value="INDIVIDUAL">👤 Individual (Enlace personal para 1 colaborador)</option>
                      </select>
                    </div>
                    <div class="form-group">
                      <label for="muestraEsperada" style="font-weight: 600; font-size: 13.5px;">Muestra Esperada:</label>
                      <input type="number" name="muestraEsperada" value="5000" min="1" class="form-input glass" id="new-muestra-esperada" />
                      <span id="muestra-helper-txt" style="font-size: 11.5px; color: var(--text-muted); display: block; margin-top: 4px;">Capacidad abierta: permite miles de respuestas simultáneas.</span>
                    </div>
                  </div>

                  <div class="form-group">
                    <label for="estado" style="font-weight: 600; font-size: 13.5px;">Estado Inicial del Enlace:</label>
                    <select name="estado" class="form-input glass">
                      <option value="LANZADO">🚀 Lanzado (Activo para recibir respuestas reales)</option>
                      <option value="TEST">🧪 Test / Prueba (Pruebas preliminares aisladas)</option>
                      <option value="BORRADOR">🔒 Borrador (Acceso cerrado temporalmente)</option>
                    </select>
                  </div>

                  <button type="submit" class="mgmt-btn-submit shine-effect" style="margin-top: 14px; font-weight: 700;">Generar Enlace de Encuesta 🚀</button>
                </form>
              </div>
            </section>
            </div>

            <div class="tab-content-panel" id="panel-trazabilidad" style="display: none;">
            {/* Listado Detallado de Respuestas con Filtros y Agrupación */}
            <div class="trazabilidad-header-row" style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 16px; flex-wrap: wrap; gap: 12px;">
              <h2 class="section-heading font-display" style="margin-bottom: 0;">Trazabilidad de Respuestas Completas</h2>
              
              <div class="grouping-controls glass" style="display: flex; gap: 4px; padding: 4px; border-radius: 8px; background: rgba(28, 28, 26, 0.03);">
                <button type="button" class="group-btn active font-display" data-group="timeline">
                  🕒 Línea de Tiempo
                </button>
                <button type="button" class="group-btn font-display" data-group="role">
                  👤 Por Rol / Cuestionario
                </button>
                <button type="button" class="group-btn font-display" data-group="dimension">
                  🛡️ Por Dimensión
                </button>
              </div>
            </div>

            <section class="all-answers-section">
              {respuestasRaw.length === 0 ? (
                <div class="glass" style="padding: 40px; border-radius: 12px; text-align: center;">
                  <p class="no-data-large" style="margin: 0; color: var(--text-muted);">Esperando envíos de colaboradores. Comparte los links para poblar el dashboard.</p>
                </div>
              ) : (
                <div>
                  {/* Vista 1: Línea de Tiempo (Flat list) */}
                  <div class="trazabilidad-view" id="view-timeline">
                    <div class="answers-grid">
                      {respuestasRaw.map(r => (
                        <div class="answer-card">
                          <div class="answer-header" style="display: flex; justify-content: space-between; align-items: center; width: 100%;">
                            <div style="display: flex; align-items: center; gap: 8px;">
                              <span class="ans-code font-display">{r.pregunta_codigo}</span>
                              <span class="ans-role">{r.cuestionario_nombre} - {r.identificador_sujeto}</span>
                            </div>
                            <form method="POST" style="margin: 0; display: inline-flex;" onsubmit="return confirm('¿Estás seguro de que deseas eliminar esta respuesta? Esto reabrirá la pregunta para el colaborador si reabres su cuestionario.');">
                              <input type="hidden" name="action" value="delete_response" />
                              <input type="hidden" name="id" value={r.id} />
                              <button type="submit" class="delete-response-btn" title="Eliminar Respuesta" style="background: none; border: none; padding: 4px; cursor: pointer; color: var(--text-muted); display: inline-flex; align-items: center; justify-content: center; border-radius: 4px; transition: all 0.15s;">
