                                <h3 class="font-display" style="font-size: 16px; margin: 0; color: var(--text-main); display: flex; align-items: center; gap: 8px;">
                                  <span style={`color: ${d.color || 'var(--primary-color)'}`}>■</span> {d.codigo} - {d.nombre}
                                  <span class="badge-role-count" style="font-size: 11px; padding: 2px 8px; border-radius: 12px; background: rgba(0,0,0,0.05); color: var(--text-muted); font-weight: 500;">
                                    {respuestasDim.length} respuestas
                                  </span>
                                </h3>
                                <p style="font-size: 12px; color: var(--text-muted); margin-top: 4px; max-width: 800px; line-height: 1.4;">{d.descripcion}</p>
