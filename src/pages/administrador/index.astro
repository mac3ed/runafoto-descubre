---
import '../../styles/global.css';
import { sql } from '../../lib/db';
import ProgressBar from '../../components/ProgressBar.svelte';
import { validateSession, destroySession } from '../../lib/auth';

const session = await validateSession(Astro.cookies);
if (!session) {
  return Astro.redirect('/administrador/login');
}


const generateUUID = () => globalThis.crypto.randomUUID();
const generateRandomHex = (size: number) => {
  const bytes = globalThis.crypto.getRandomValues(new Uint8Array(size));
  return Array.from(bytes).map(b => b.toString(16).padStart(2, '0')).join('');
};

const safeParseOptions = (opciones: any): string[] => {
  if (!opciones) return [];
  if (Array.isArray(opciones)) return opciones;
  if (typeof opciones === 'string') {
    try {
      const parsed = JSON.parse(opciones);
      if (Array.isArray(parsed)) return parsed;
    } catch (_) {
      return opciones.split(',').map((s: string) => s.trim()).filter(Boolean);
    }
  }
  return [];
};

// Desactivar prerendering estático
export const prerender = false;

let errorMsg = '';
let postSuccess = '';
let postError = '';

let totalAsignaciones = 0;
let asignacionesCompletadas = 0;
let participacionPorcentaje = 0;
let totalRespuestas = 0;
let colaboradoresGrupalesUnicos = 0;

let dimensiones: any[] = [];
let respuestasRaw: any[] = [];
let asignaciones: any[] = [];
let cuestionarios: any[] = [];

// Procesar acciones de formulario administrativo (Crear, Editar, Eliminar asignación, Cuestionarios y Preguntas)
if (Astro.request.method === 'POST') {
  // A1: Verificación CSRF — validar que el Origin coincide con el servidor (o proviene del túnel de desarrollo)
  const requestOrigin = Astro.request.headers.get('origin');
  const expectedOrigin = new URL(Astro.request.url).origin;
  const isAllowedOrigin = requestOrigin?.endsWith('.trycloudflare.com') || requestOrigin?.includes('localhost') || false;
  if (requestOrigin && !isAllowedOrigin && requestOrigin !== expectedOrigin) {
    return new Response('Forbidden — CSRF origin mismatch', { status: 403 });
  }

  try {
    const formData = await Astro.request.formData();
    const action = formData.get('action') as string;

    if (action === 'logout') {
      await destroySession(Astro.cookies);
      return Astro.redirect('/administrador/login');
    }

    if (action === 'update_assignment') {
      const id = formData.get('id') as string;
      const tipoSujeto = formData.get('tipoSujeto') as string;
      const identificadorSujeto = formData.get('identificadorSujeto') as string;
      const muestraEsperada = parseInt(formData.get('muestraEsperada') as string, 10);
      const cuestionarioId = formData.get('cuestionarioId') as string;
      const estado = formData.get('estado') as string || 'LANZADO';

      let finalEstado = estado;
      
      // Si el estado es LANZADO o COMPLETADO, recalculamos dinámicamente según la muestra y tipo de sujeto
      if (estado === 'LANZADO' || estado === 'COMPLETADO') {
        if (tipoSujeto === 'GRUPAL') {
          const [sesionesCountRes] = await sql`
            SELECT COUNT(DISTINCT valor->>'sesionId') as total
            FROM respuesta
            WHERE asignacion_id = ${id}
          `;
          const completados = parseInt(sesionesCountRes?.total || '0', 10);
          if (completados >= muestraEsperada) {
            finalEstado = 'COMPLETADO';
          } else {
            finalEstado = 'LANZADO';
          }
        }
      }

      await sql`
        UPDATE asignacion 
        SET tipo_sujeto = ${tipoSujeto}, 
            identificador_sujeto = ${identificadorSujeto},
            muestra_esperada = ${muestraEsperada},
            cuestionario_id = ${cuestionarioId},
            estado = ${finalEstado},
            completado_en = CASE 
              WHEN ${finalEstado} = 'COMPLETADO' THEN COALESCE(completado_en, CURRENT_TIMESTAMP)
              ELSE NULL 
            END
        WHERE id = ${id}
      `;
      postSuccess = 'Asignación actualizada correctamente.';
    } else if (action === 'create_assignment') {
      const cuestionarioId = formData.get('cuestionarioId') as string;
      const tipoSujeto = formData.get('tipoSujeto') as string;
      const identificadorSujeto = formData.get('identificadorSujeto') as string;
      const muestraEsperada = parseInt(formData.get('muestraEsperada') as string, 10);
      const estado = formData.get('estado') as string || 'LANZADO';
      
      const token = generateUUID();
      const newId = generateUUID();

      await sql`
        INSERT INTO asignacion (id, cuestionario_id, token, tipo_sujeto, identificador_sujeto, muestra_esperada, estado)
        VALUES (${newId}, ${cuestionarioId}, ${token}, ${tipoSujeto}, ${identificadorSujeto}, ${muestraEsperada}, ${estado})
      `;
      
      const [cuestionarioInfo] = await sql`SELECT hito_id FROM cuestionario WHERE id = ${cuestionarioId}`;
      const hitoId = cuestionarioInfo ? cuestionarioInfo.hito_id : '';
      return Astro.redirect(`/administrador?hitoId=${hitoId}&tab=lanzamiento&admin_enlace_id=${newId}`);
    } else if (action === 'delete_response') {
      const id = formData.get('id') as string;
      const [respInfo] = await sql`SELECT asignacion_id FROM respuesta WHERE id = ${id}`;
      if (respInfo) {
        await sql`DELETE FROM respuesta WHERE id = ${id}`;
        await sql`UPDATE asignacion SET completado_en = NULL WHERE id = ${respInfo.asignacion_id}`;
        postSuccess = 'Respuesta eliminada correctamente de la base de datos y cuestionario reabierto automáticamente.';
      } else {
        await sql`DELETE FROM respuesta WHERE id = ${id}`;
        postSuccess = 'Respuesta eliminada correctamente de la base de datos.';
      }
    } else if (action === 'delete_assignment') {
      const id = formData.get('id') as string;
      const [assignmentInfo] = await sql`
        SELECT c.hito_id 
        FROM asignacion a
        JOIN cuestionario c ON a.cuestionario_id = c.id
        WHERE a.id = ${id}
      `;
      const hitoId = assignmentInfo ? assignmentInfo.hito_id : '';
      await sql`DELETE FROM asignacion WHERE id = ${id}`;
      return Astro.redirect(`/administrador?hitoId=${hitoId}&tab=lanzamiento&deleted_ok=1`);
    } else if (action === 'create_questionnaire') {
      const nombre = formData.get('nombre') as string;
      const descripcion = formData.get('descripcion') as string;
      const hitoId = formData.get('hitoId') as string;
      const newId = generateUUID();

      await sql`
        INSERT INTO cuestionario (id, hito_id, nombre, descripcion, version)
        VALUES (${newId}, ${hitoId}, ${nombre}, ${descripcion}, 1)
      `;
      
      return Astro.redirect(`/administrador?hitoId=${hitoId}&select_cuestionario_id=${newId}&tab=roles&created_ok=1`);
    } else if (action === 'update_questionnaire') {
      const id = formData.get('id') as string;
      const nombre = formData.get('nombre') as string;
      const descripcion = formData.get('descripcion') as string;

      await sql`
        UPDATE cuestionario 
        SET nombre = ${nombre}, descripcion = ${descripcion}
        WHERE id = ${id}
      `;
      postSuccess = 'Cuestionario actualizado correctamente.';
    } else if (action === 'delete_questionnaire') {
      const id = formData.get('id') as string;
      await sql`DELETE FROM cuestionario WHERE id = ${id}`;
      postSuccess = 'Cuestionario y sus preguntas asociadas eliminados.';
    } else if (action === 'create_dimension') {
      const codigo = formData.get('codigo') as string;
      const nombre = formData.get('nombre') as string;
      const descripcion = formData.get('descripcion') as string;
      const color = formData.get('color') as string || '#0F6CBD';
      const hitoId = formData.get('hitoId') as string;
      const id = generateUUID(); // Usar UUID dinámico

      await sql`
        INSERT INTO dimension (id, hito_id, codigo, nombre, descripcion, color)
        VALUES (${id}, ${hitoId}, ${codigo}, ${nombre}, ${descripcion}, ${color})
      `;
      return Astro.redirect(`/administrador?hitoId=${hitoId}&tab=dimensiones&created_ok=2`);
    } else if (action === 'update_dimension') {
      const id = formData.get('id') as string;
      const codigo = formData.get('codigo') as string;
      const nombre = formData.get('nombre') as string;
      const descripcion = formData.get('descripcion') as string;
      const color = formData.get('color') as string || '#0F6CBD';
      const hitoId = formData.get('hitoId') as string;

      await sql`
        UPDATE dimension 
        SET codigo = ${codigo}, nombre = ${nombre}, descripcion = ${descripcion}, color = ${color}
        WHERE id = ${id}
      `;
      postSuccess = `Dimensión "${codigo}" actualizada correctamente.`;
    } else if (action === 'delete_dimension') {
      const id = formData.get('id') as string;
      await sql`DELETE FROM dimension WHERE id = ${id}`;
      postSuccess = 'Dimensión eliminada correctamente del sistema.';
    } else if (action === 'create_campaign') {
      const nombre = formData.get('nombre') as string;
      const clonarHitoId = formData.get('clonarHitoId') as string;
      const newId = generateUUID();
      
      // Desactivar otros hitos si se crea uno nuevo
      await sql`UPDATE hito SET activo = FALSE`;

      await sql`
        INSERT INTO hito (id, nombre, fecha_inicio, fecha_fin, activo)
        VALUES (${newId}, ${nombre}, NOW(), NOW() + INTERVAL '30 days', TRUE)
      `;

      // Si se solicitó clonar la estructura de otra campaña
      if (clonarHitoId && clonarHitoId !== 'none') {
        try {
          // 1. Clonar Dimensiones
          const oldDimensions = await sql`SELECT * FROM dimension WHERE hito_id = ${clonarHitoId}`;
          const dimMap = new Map(); // Mapa [old_id -> new_uuid]

          for (const dim of oldDimensions) {
            const newDimId = generateUUID();
            dimMap.set(dim.id, newDimId);
            await sql`
              INSERT INTO dimension (id, hito_id, codigo, nombre, descripcion, color)
              VALUES (${newDimId}, ${newId}, ${dim.codigo}, ${dim.nombre}, ${dim.descripcion}, ${dim.color})
            `;
          }

          // 2. Clonar Cuestionarios
          const oldCuestionarios = await sql`SELECT * FROM cuestionario WHERE hito_id = ${clonarHitoId}`;
          const questMap = new Map(); // Mapa [old_id -> new_uuid]

          for (const q of oldCuestionarios) {
            const newQuestId = generateUUID();
            questMap.set(q.id, newQuestId);
            await sql`
              INSERT INTO cuestionario (id, hito_id, nombre, descripcion, version, metadatos)
              VALUES (${newQuestId}, ${newId}, ${q.nombre}, ${q.descripcion}, ${q.version}, ${JSON.stringify(q.metadatos)}::jsonb)
            `;
          }

          // 3. Clonar Preguntas asociadas a los cuestionarios clonados
          for (const oldQuestId of questMap.keys()) {
            const oldPreguntas = await sql`SELECT * FROM pregunta WHERE cuestionario_id = ${oldQuestId} ORDER BY orden ASC`;
            const newQuestId = questMap.get(oldQuestId);

            for (const p of oldPreguntas) {
              const newPregId = generateUUID();
              const newDimId = dimMap.get(p.dimension_id);
              
              if (newDimId && newQuestId) {
                await sql`
                  INSERT INTO pregunta (id, cuestionario_id, codigo, texto, tipo, opciones, dimension_id, version, respuesta_critica)
                  VALUES (${newPregId}, ${newQuestId}, ${p.codigo}, ${p.texto}, ${p.tipo}, ${JSON.stringify(p.opciones)}::jsonb, ${newDimId}, ${p.version}, ${p.respuesta_critica})
                `;
              }
            }
          }
          console.log(`✓ Estructura de la campaña ${clonarHitoId} clonada con éxito en ${newId}`);
        } catch (cloneErr) {
          console.error("Error al clonar estructura de campaña:", cloneErr);
        }
      }

      return Astro.redirect(`/administrador?hitoId=${newId}&created_ok=3`);
    } else if (action === 'create_question') {
      const cuestionarioId = (formData.get('cuestionarioId') || formData.get('cuestionario_id')) as string;
      const codigo = formData.get('codigo') as string;
      const texto = formData.get('texto') as string;
      const tipo = formData.get('tipo') as string;
      const opcionesStr = formData.get('opciones') as string || '[]';
      const dimensionId = (formData.get('dimensionId') || formData.get('dimension_id')) as string;
      const respuestaCritica = (formData.get('respuestaCritica') || formData.get('respuesta_critica')) as string || null;

      let opciones = [];
      try {
        opciones = JSON.parse(opcionesStr);
      } catch (e) {
        opciones = opcionesStr.split(',').map(s => s.trim()).filter(Boolean);
      }

      await sql`
        INSERT INTO pregunta (id, cuestionario_id, codigo, texto, tipo, opciones, dimension_id, version, respuesta_critica)
        VALUES (${generateUUID()}, ${cuestionarioId}, ${codigo}, ${texto}, ${tipo}, ${JSON.stringify(opciones)}::jsonb, ${dimensionId}, 1, ${respuestaCritica})
      `;
      postSuccess = `Pregunta "${codigo}" agregada al cuestionario.`;
    } else if (action === 'update_question') {
      const id = formData.get('id') as string;
      const codigo = formData.get('codigo') as string;
      const texto = formData.get('texto') as string;
      const tipo = formData.get('tipo') as string;
      const opcionesStr = formData.get('opciones') as string || '[]';
      const dimensionId = (formData.get('dimensionId') || formData.get('dimension_id')) as string;
      const respuestaCritica = (formData.get('respuestaCritica') || formData.get('respuesta_critica')) as string || null;

      let opciones = [];
      try {
        opciones = JSON.parse(opcionesStr);
      } catch (e) {
        opciones = opcionesStr.split(',').map(s => s.trim()).filter(Boolean);
      }

      await sql`
        UPDATE pregunta 
        SET codigo = ${codigo}, texto = ${texto}, tipo = ${tipo}, opciones = ${JSON.stringify(opciones)}::jsonb, dimension_id = ${dimensionId}, respuesta_critica = ${respuestaCritica}
        WHERE id = ${id}
      `;
      postSuccess = `Pregunta "${codigo}" actualizada.`;
    } else if (action === 'delete_question') {
      const id = formData.get('id') as string;
      await sql`DELETE FROM pregunta WHERE id = ${id}`;
      postSuccess = 'Pregunta eliminada correctamente.';
    }
  } catch (e: any) {
    console.error('Error procesando POST administrativo:', e);
    // A4: No exponer detalles internos del error al cliente
    postError = 'Error al procesar la acción. Contacte al administrador del sistema.';
  }
}

let todasLasPreguntas: any[] = [];

let selectCuestionarioId = '';
let selectedCuestionario: any = null;
let cuestionarioPreguntas: any[] = [];
let configProgress = 0;
let asignacionesFiltradas: any[] = [];
let respuestasFiltradas: any[] = [];
let hitos: any[] = [];
let hitosConMetricas: any[] = [];
let fugasDeValor: any[] = [];
let brechasPorDimension: any[] = [];
let matrizFriccion: any[] = [];
let activeHitoId = '';
let activeHito: any = null;
let diagnosticoInteligente: any = null;
let hitoIdComparar = '';
let comparacionPreguntas: any[] = [];
let respuestasComparar: any[] = [];
let respuestasPorRol: Record<string, any[]> = {};
let respuestasPorDimension: Record<string, any[]> = {};

let adminEnlaceId = '';
let selectedEnlace: any = null;
let selectedEnlacePreguntas: any[] = [];
let selectedEnlaceRespuestas: any[] = [];
let selectedEnlaceCompletados = 0;
let selectedEnlaceCobertura = 0;
let fraudAlerts: any[] = [];

try {
  // Obtener parámetro de vista de la URL
  const url = new URL(Astro.request.url);

  selectCuestionarioId = url.searchParams.get('select_cuestionario_id') || '';
  adminEnlaceId = url.searchParams.get('admin_enlace_id') || '';
  const createdOk = url.searchParams.get('created_ok');
  const deletedOk = url.searchParams.get('deleted_ok');
  if (createdOk === '1') {
    postSuccess = 'Plantilla de cuestionario (Rol) creada con éxito. Ya puedes generar su enlace.';
  } else if (createdOk === '2') {
    postSuccess = 'Dimensión de análisis creada con éxito. Ya puedes vincularle preguntas.';
  } else if (createdOk === '3') {
    postSuccess = 'Nueva Campaña de Investigación creada con éxito. Estructura su diagnóstico abajo.';
  } else if (deletedOk === '1') {
    postSuccess = 'Enlace de cuestionario eliminado correctamente.';
  }

  // 1. Obtener todas las campañas de investigación (hitos)
  hitos = await sql`SELECT * FROM hito ORDER BY fecha_inicio DESC`;
  
  // 2. Determinar la campaña seleccionada (si no hay hitoId en URL, estamos en Dashboard Global)
  const selectedHitoId = url.searchParams.get('hitoId');
  if (selectedHitoId) {
    activeHito = hitos.find(h => h.id === selectedHitoId) || null;
  } else {
    activeHito = null;
  }
  activeHitoId = activeHito ? activeHito.id : '';

  // 3. Obtener dimensiones de esta campaña
  dimensiones = activeHitoId 
    ? await sql`SELECT * FROM dimension WHERE hito_id = ${activeHitoId} ORDER BY codigo ASC`
    : [];

  diagnosticoInteligente = activeHitoId
    ? (await sql`SELECT * FROM diagnostico_inteligente WHERE hito_id = ${activeHitoId}`)[0] || null
    : null;

  // 4. Obtener cuestionarios de esta campaña
  cuestionarios = activeHitoId 
    ? await sql`SELECT * FROM cuestionario WHERE hito_id = ${activeHitoId} ORDER BY nombre ASC`
    : [];

  // 5. Obtener asignaciones vinculadas a cuestionarios de esta campaña
  asignaciones = activeHitoId
    ? await sql`
       SELECT a.id, a.cuestionario_id, a.token, a.tipo_sujeto, a.identificador_sujeto, a.muestra_esperada, a.estado, a.completado_en,
              c.nombre as cuestionario_nombre
       FROM asignacion a
       JOIN cuestionario c ON a.cuestionario_id = c.id
       WHERE c.hito_id = ${activeHitoId}
       ORDER BY a.identificador_sujeto ASC
    `
    : [];

  // 6. Obtener respuestas vinculadas a esta campaña
  respuestasRaw = activeHitoId
    ? await sql`
       SELECT r.id, r.pregunta_id, r.asignacion_id, r.valor, r.creado_en,
              p.codigo as pregunta_codigo, p.texto as pregunta_texto, p.dimension_id, p.tipo as pregunta_tipo, p.respuesta_critica,
              a.identificador_sujeto, a.tipo_sujeto, a.estado as asignacion_estado, c.nombre as cuestionario_nombre
       FROM respuesta r
       JOIN pregunta p ON r.pregunta_id = p.id
       JOIN asignacion a ON r.asignacion_id = a.id
       JOIN cuestionario c ON a.cuestionario_id = c.id
       WHERE c.hito_id = ${activeHitoId}
       ORDER BY r.creado_en DESC
    `
    : [];

  // 7. Obtener todas las preguntas de cuestionarios de esta campaña
  todasLasPreguntas = activeHitoId
    ? await sql`
       SELECT p.* 
       FROM pregunta p 
       JOIN cuestionario c ON p.cuestionario_id = c.id
       WHERE c.hito_id = ${activeHitoId}
       ORDER BY p.orden ASC
    `
    : [];
    
  // 8. Agrupaciones para la sección de Trazabilidad
  respuestasPorRol = {};
  respuestasRaw.forEach(r => {
    const key = `${r.cuestionario_nombre} - ${r.identificador_sujeto}`;
    if (!respuestasPorRol[key]) {
      respuestasPorRol[key] = [];
    }
    respuestasPorRol[key].push(r);
  });
  // Ordenar respuestas dentro de cada rol por el código de pregunta
  Object.keys(respuestasPorRol).forEach(key => {
    respuestasPorRol[key].sort((a, b) => a.pregunta_codigo.localeCompare(b.pregunta_codigo, undefined, { numeric: true, sensitivity: 'base' }));
  });

  respuestasPorDimension = {};
  dimensiones.forEach(d => {
    respuestasPorDimension[d.id] = [];
  });
  respuestasRaw.forEach(r => {
    if (!respuestasPorDimension[r.dimension_id]) {
      respuestasPorDimension[r.dimension_id] = [];
    }
    respuestasPorDimension[r.dimension_id].push(r);
  });
    
  if (activeHitoId && cuestionarios.length > 0) {
    if (!selectCuestionarioId) {
      selectCuestionarioId = cuestionarios[0].id;
    }
    selectedCuestionario = cuestionarios.find(c => c.id === selectCuestionarioId) || null;
    cuestionarioPreguntas = selectedCuestionario
      ? todasLasPreguntas.filter(p => p.cuestionario_id === selectedCuestionario.id)
      : [];
  }

  // --- MÉTRICAS OFICIALES (Enlaces LANZADOS y COMPLETADOS alimentan los KPIs) ---
  if (activeHitoId) {
    asignacionesFiltradas = asignaciones.filter(a => a.estado === 'LANZADO' || a.estado === 'COMPLETADO');
    respuestasFiltradas = respuestasRaw.filter(r => r.asignacion_estado === 'LANZADO' || r.asignacion_estado === 'COMPLETADO');

    totalAsignaciones = asignacionesFiltradas.length;
    asignacionesCompletadas = asignacionesFiltradas.filter(a => a.completado_en).length;
    participacionPorcentaje = totalAsignaciones > 0 ? Math.round((asignacionesCompletadas / totalAsignaciones) * 100) : 0;
    totalRespuestas = respuestasFiltradas.length;

    const sesionesUnicas = new Set();
    respuestasFiltradas.forEach(r => {
      if (r.tipo_sujeto === 'GRUPAL' && r.valor?.sesionId) {
        sesionesUnicas.add(r.valor.sesionId);
      }
    });
    colaboradoresGrupalesUnicos = sesionesUnicas.size;

    fugasDeValor = respuestasFiltradas.filter(r => {
      const val = r.valor?.respuesta;
      return r.respuesta_critica && val !== undefined && val !== null && (Array.isArray(val) ? val.includes(r.respuesta_critica) : String(val).trim().toLowerCase() === String(r.respuesta_critica).trim().toLowerCase());
    });

    // --- LÓGICA DE BRECHAS CUANTITATIVAS ---
    const calculateAnswerScore = (val: any, opcionesJson: any): number | null => {
      if (val === undefined || val === null) return null;
      const strVal = String(val).trim().toLowerCase();
      
      if (strVal === 'sí' || strVal === 'si' || strVal === 'verdadero' || strVal === 'true') return 100;
      if (strVal === 'no' || strVal === 'falso' || strVal === 'false') return 0;
      
      const opciones = safeParseOptions(opcionesJson);
      if (opciones && opciones.length > 1) {
        const idx = opciones.findIndex(o => o.trim().toLowerCase() === strVal);
        if (idx !== -1) {
          const firstOpt = opciones[0].toLowerCase();
          const isDesc = firstOpt.includes('excelente') || firstOpt.includes('bueno') || firstOpt.includes('alto') || firstOpt.includes('sí') || firstOpt.includes('si') || firstOpt.includes('óptimo') || firstOpt.includes('correcto');
          if (isDesc) {
            return Math.round(((opciones.length - 1 - idx) / (opciones.length - 1)) * 100);
          } else {
            return Math.round((idx / (opciones.length - 1)) * 100);
          }
        }
      }
      return null;
    };

    brechasPorDimension = dimensiones.map(dim => {
      const respuestasDim = respuestasFiltradas.filter(r => r.dimension_id === dim.id);
      
      const respuestasDir = respuestasDim.filter(r => {
        const name = r.identificador_sujeto.toLowerCase();
        const rol = r.cuestionario_nombre.toLowerCase();
        return name.includes('douglas') || name.includes('betty') || name.includes('karla') || name.includes('yeri') || name.includes('dirección') || name.includes('administracion') || rol.includes('dirección') || rol.includes('administración');
      });
      
      const respuestasOp = respuestasDim.filter(r => {
        const name = r.identificador_sujeto.toLowerCase();
        const rol = r.cuestionario_nombre.toLowerCase();
        return !(name.includes('douglas') || name.includes('betty') || name.includes('karla') || name.includes('yeri') || name.includes('dirección') || name.includes('administracion') || rol.includes('dirección') || rol.includes('administración'));
      });
      
      const getAverage = (list: any[]) => {
        let sum = 0;
        let count = 0;
        list.forEach(r => {
          const q = todasLasPreguntas.find(p => p.id === r.pregunta_id);
          const score = calculateAnswerScore(r.valor?.respuesta, q?.opciones);
          if (score !== null) {
            sum += score;
            count++;
          }
        });
        return count > 0 ? Math.round(sum / count) : null;
      };
      
      const avgDir = getAverage(respuestasDir);
      const avgOp = getAverage(respuestasOp);
      const brecha = (avgDir !== null && avgOp !== null) ? (avgDir - avgOp) : null;
      
      return {
        id: dim.id,
        codigo: dim.codigo,
        nombre: dim.nombre,
        color: dim.color,
        avgDir,
        avgOp,
        brecha
      };
    });

    // --- LÓGICA DE MATRIZ DE FRICCIÓN (Rol vs Dimensión) ---
    matrizFriccion = asignacionesFiltradas.map(asig => {
      const respuestasAsig = respuestasFiltradas.filter(r => r.asignacion_id === asig.id);
      
      const dimensionesData = dimensiones.map(dim => {
        const respuestasDim = respuestasAsig.filter(r => r.dimension_id === dim.id);
        const total = respuestasDim.length;
        const fricciones = respuestasDim.filter(r => {
          const val = r.valor?.respuesta;
          return r.respuesta_critica && val !== undefined && val !== null && (Array.isArray(val) ? val.includes(r.respuesta_critica) : String(val).trim().toLowerCase() === String(r.respuesta_critica).trim().toLowerCase());
        }).length;
        
        return {
          dimension_id: dim.id,
          total,
          fricciones,
          porcentajeFriccion: total > 0 ? Math.round((fricciones / total) * 100) : 0
        };
      });
      
      return {
        colaborador: asig.identificador_sujeto,
        rol: asig.cuestionario_nombre,
        dimensiones: dimensionesData
      };
    });

    // Calcular Progreso de Configuración
    configProgress = 20;
    if (dimensiones.length > 0) configProgress += 20;
    if (cuestionarios.length > 0 && todasLasPreguntas.length > 0) configProgress += 30;
    if (asignaciones.length > 0) configProgress += 30;
  } else {
    // --- LÓGICA DE DASHBOARD GLOBAL ---
    const allAssignments = await sql`SELECT id, completado_en, estado FROM asignacion`;
    const allResponses = await sql`
      SELECT r.id, r.valor, p.respuesta_critica
      FROM respuesta r
      JOIN pregunta p ON r.pregunta_id = p.id
    `;

    const activeAssignments = allAssignments.filter(a => a.estado === 'LANZADO' || a.estado === 'COMPLETADO');
    totalAsignaciones = activeAssignments.length;
    asignacionesCompletadas = activeAssignments.filter(a => a.completado_en).length;
    participacionPorcentaje = totalAsignaciones > 0 ? Math.round((asignacionesCompletadas / totalAsignaciones) * 100) : 0;
    totalRespuestas = allResponses.length;
    colaboradoresGrupalesUnicos = 0;

    fugasDeValor = allResponses.filter(r => {
      const val = r.valor?.respuesta;
      return r.respuesta_critica && val !== undefined && val !== null && (Array.isArray(val) ? val.includes(r.respuesta_critica) : String(val).trim().toLowerCase() === String(r.respuesta_critica).trim().toLowerCase());
    });

    // Calcular participación hito por hito para la tabla del Dashboard Global
    hitosConMetricas = await Promise.all(hitos.map(async (h) => {
      const asigns = await sql`
        SELECT a.id, a.completado_en 
        FROM asignacion a
        JOIN cuestionario c ON a.cuestionario_id = c.id
        WHERE c.hito_id = ${h.id} AND a.estado = 'LANZADO'
      `;
      const total = asigns.length;
      const completed = asigns.filter(a => a.completado_en).length;
      const pct = total > 0 ? Math.round((completed / total) * 100) : 0;
      return {
        id: h.id,
        nombre: h.nombre,
        fecha_inicio: h.fecha_inicio,
        activo: h.activo,
        total,
        completed,
        pct
      };
    }));
  }

  // 7. LÓGICA DE COMPARACIÓN DE CAMPAÑAS
  hitoIdComparar = url.searchParams.get('hitoIdComparar') || '';
  if (hitoIdComparar && hitoIdComparar !== 'none') {
    // Obtener respuestas oficiales de la campaña base
    respuestasComparar = await sql`
      SELECT r.id, r.pregunta_id, r.valor, p.codigo as pregunta_codigo, p.respuesta_critica
      FROM respuesta r
      JOIN pregunta p ON r.pregunta_id = p.id
      JOIN asignacion a ON r.asignacion_id = a.id
      JOIN cuestionario c ON a.cuestionario_id = c.id
      WHERE c.hito_id = ${hitoIdComparar} AND a.estado = 'LANZADO'
    `;

    // Mapear comparación por código de pregunta idéntico
    comparacionPreguntas = todasLasPreguntas.map(p => {
      // Distribución en campaña activa
      const respActivas = respuestasFiltradas.filter(r => r.pregunta_codigo === p.codigo);
      const critActivas = respActivas.filter(r => {
        const val = r.valor?.respuesta;
        return p.respuesta_critica && val !== undefined && val !== null && (Array.isArray(val) ? val.includes(p.respuesta_critica) : String(val).trim().toLowerCase() === String(p.respuesta_critica).trim().toLowerCase());
      }).length;
      const pctActiva = respActivas.length > 0 ? Math.round((critActivas / respActivas.length) * 100) : 0;

      // Distribución en campaña a comparar
      const respComp = respuestasComparar.filter(r => r.pregunta_codigo === p.codigo);
      const critComp = respComp.filter(r => {
        const val = r.valor?.respuesta;
        return r.respuesta_critica && val !== undefined && val !== null && (Array.isArray(val) ? val.includes(r.respuesta_critica) : String(val).trim().toLowerCase() === String(r.respuesta_critica).trim().toLowerCase());
      }).length;
      const pctComp = respComp.length > 0 ? Math.round((critComp / respComp.length) * 100) : 0;

      const diferencia = pctActiva - pctComp; // Cambio en fricción (negativo es bueno)

      return {
        codigo: p.codigo,
        texto: p.texto,
        pctActiva,
        pctComparar: pctComp,
        respActivasCount: respActivas.length,
        respCompararCount: respComp.length,
        critActivasCount: critActivas,
        critCompararCount: critComp,
        diferencia,
        tieneDatos: respActivas.length > 0 || respComp.length > 0
      };
    }).filter(c => c.tieneDatos);
  }

  // 8. Cargar datos para la administración consolidada del enlace si está seleccionado
  if (adminEnlaceId) {
    const [dbEnlace] = await sql`
      SELECT a.id, a.cuestionario_id, a.token, a.tipo_sujeto, a.identificador_sujeto, a.muestra_esperada, a.estado, a.completado_en,
             c.nombre as cuestionario_nombre
      FROM asignacion a
      JOIN cuestionario c ON a.cuestionario_id = c.id
      WHERE a.id = ${adminEnlaceId}
    `;
    if (dbEnlace) {
      selectedEnlace = dbEnlace;
      
      // Get questions for the associated questionnaire
      selectedEnlacePreguntas = await sql`
        SELECT * FROM pregunta 
        WHERE cuestionario_id = ${selectedEnlace.cuestionario_id} 
        ORDER BY orden ASC
      `;
      
      // Get responses for this assignment
      selectedEnlaceRespuestas = await sql`
        SELECT r.id, r.pregunta_id, r.valor, r.creado_en,
               p.codigo as pregunta_codigo, p.texto as pregunta_texto, p.dimension_id, p.tipo as pregunta_tipo
        FROM respuesta r
        JOIN pregunta p ON r.pregunta_id = p.id
        WHERE r.asignacion_id = ${selectedEnlace.id}
        ORDER BY r.creado_en DESC
      `;
      
      selectedEnlaceCompletados = selectedEnlace.tipo_sujeto === 'INDIVIDUAL'
        ? (selectedEnlace.completado_en ? 1 : 0)
        : new Set(selectedEnlaceRespuestas.map(r => r.valor?.sesionId).filter(Boolean)).size;
        
      selectedEnlaceCobertura = selectedEnlace.tipo_sujeto === 'INDIVIDUAL'
        ? (selectedEnlace.completado_en ? 100 : 0)
        : (selectedEnlace.muestra_esperada > 0 ? Math.min(100, Math.round((selectedEnlaceCompletados / selectedEnlace.muestra_esperada) * 100)) : 0);

      // Audit multi-device / fraud alerts for this link
      const respuestasPorDispositivoLocal: Record<string, { deviceId: string, fingerprint: string, envios: Set<string>, totalResp: number }> = {};
      selectedEnlaceRespuestas.forEach(r => {
        const devId = r.valor?.deviceId || 'unknown';
        const fp = r.valor?.fingerprint || 'unknown';
        if (devId === 'unknown') return;

        const identificador = selectedEnlace.identificador_sujeto;
        const sesId = r.valor?.sesionId || 'default';
        const claveEnvio = `${identificador} (Sesión: ${sesId.substring(0, 6)})`;

        if (!respuestasPorDispositivoLocal[devId]) {
          respuestasPorDispositivoLocal[devId] = {
            deviceId: devId,
            fingerprint: fp,
            envios: new Set(),
            totalResp: 0
          };
        }
        respuestasPorDispositivoLocal[devId].envios.add(claveEnvio);
        respuestasPorDispositivoLocal[devId].totalResp++;
      });
      fraudAlerts = Object.values(respuestasPorDispositivoLocal).filter(d => d.envios.size > 1);
    }
  }

} catch (error) {
  console.error('Error al cargar datos del Dashboard:', error);
  errorMsg = 'Error al conectar con la base de datos PostgreSQL.';
}

// Analizar auditoría de WiFi y multi-envíos (duplicación de deviceId)
const respuestasPorDispositivo: Record<string, { deviceId: string, fingerprint: string, envios: Set<string>, cuestionarios: Set<string>, totalResp: number }> = {};
respuestasRaw.forEach(r => {
  const devId = r.valor?.deviceId || 'unknown';
  const fp = r.valor?.fingerprint || 'unknown';
  if (devId === 'unknown') return;

  const identificador = r.identificador_sujeto;
  const sesId = r.valor?.sesionId || 'default';
  const claveEnvio = `${identificador} (Sesión: ${sesId.substring(0, 6)})`;

  if (!respuestasPorDispositivo[devId]) {
    respuestasPorDispositivo[devId] = {
      deviceId: devId,
      fingerprint: fp,
      envios: new Set(),
      cuestionarios: new Set(),
      totalResp: 0
    };
  }
  respuestasPorDispositivo[devId].envios.add(claveEnvio);
  respuestasPorDispositivo[devId].cuestionarios.add(r.cuestionario_nombre);
  respuestasPorDispositivo[devId].totalResp++;
});

// Duplicados sospechosos (mismo terminal físico respondiendo bajo identidades/sesiones diferentes)
const alertasFraude = Object.values(respuestasPorDispositivo).filter(d => d.envios.size > 1);

// Helper para clasificar y agrupar respuestas por dimensión en el servidor
const getRespuestasPorDimension = (dimId: string) => {
  return respuestasRaw.filter(r => r.dimension_id === dimId);
};

const getDimensionName = (dimId: string) => {
  const dim = dimensiones.find(d => d.id === dimId);
  return dim ? `${dim.codigo} - ${dim.nombre}` : dimId;
};

