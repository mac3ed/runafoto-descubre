                              <th style="padding: 12px; color: var(--text-muted); font-weight: 600; text-transform: uppercase; font-size: 11px; letter-spacing: 0.5px;">Participación</th>
                              <th style="padding: 12px; color: var(--text-muted); font-weight: 600; text-transform: uppercase; font-size: 11px; letter-spacing: 0.5px; text-align: right;">Acciones</th>
                            </tr>
