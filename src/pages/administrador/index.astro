                                  )}
                                </td>
                                <td style="padding: 14px 12px;">
                                  <div style="display: flex; align-items: center; gap: 10px; width: 180px;">
                                    <span style="font-weight: 600; min-width: 50px; font-size: 12.5px;">{h.pct}%</span>
                                    <div style="flex: 1; height: 6px; background: rgba(0,0,0,0.05); border-radius: 999px; overflow: hidden;">
