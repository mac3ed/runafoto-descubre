                    <button type="button" onclick="document.querySelector('[data-step=dimensiones]').click()" class="btn-save" style="padding: 8px 16px; font-size: 12.5px; border-radius: 6px; font-weight: 700; cursor: pointer; height: auto;">Diseñar Investigación →</button>
