  .error-box {
    padding: 24px;
    border-radius: 12px;
    border-color: hsla(0, 85%, 60%, 0.2);
    color: var(--danger-color);
    margin-bottom: 24px;
  }

  .error-sub {
    font-size: 13px;
    color: var(--text-muted);
    margin-top: 8px;
  }

  /* Grid de KPIs */
  .kpi-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
    gap: 20px;
    margin-bottom: 36px;
  }

  .kpi-card {
    padding: 24px;
    border-radius: 12px;
    display: flex;
    flex-direction: column;
    gap: 12px;
  }

  .kpi-title {
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 1px;
    color: var(--text-muted);
  }

  .kpi-value-row {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 8px;
  }

  .kpi-value {
    font-size: 32px;
    font-weight: 700;
  }

  .kpi-subtext {
    font-size: 12px;
    color: var(--text-muted);
  }

  .alert-card {
    border-color: hsla(330, 85%, 55%, 0.2);
  }

  .alert-title {
    color: var(--accent-color);
  }

  .text-alert {
    color: var(--accent-color);
  }

  .section-heading {
    font-size: 18px;
    font-weight: 600;
    color: var(--text-main);
    margin-top: 32px;
    margin-bottom: 16px;
    letter-spacing: -0.01em;
  }

  .section-heading.text-alert {
    color: var(--accent-color);
  }

  /* Grid de Dimensiones */
  .dimensions-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(320px, 1fr));
    gap: 20px;
    margin-bottom: 36px;
  }

  .dimension-card {
    padding: 24px;
    border-radius: 12px;
    display: flex;
    flex-direction: column;
    gap: 16px;
  }

  .dim-header {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    padding-left: 12px;
  }

  .dim-code {
    font-size: 12px;
    font-weight: 700;
    color: var(--text-muted);
  }

  .dim-name {
    font-size: 18px;
    font-weight: 700;
    margin-top: 2px;
  }

  .dim-count {
    font-size: 12px;
    font-weight: 700;
    background-color: hsla(var(--hue-neutral), 30%, 20%, 0.4);
    padding: 4px 8px;
    border-radius: 6px;
  }

  .dim-desc {
    font-size: 13px;
    color: var(--text-muted);
    line-height: 1.4;
  }

  .dim-answers-summary {
    border-top: 1px solid var(--border-glass);
    padding-top: 12px;
  }

  .summary-title {
    font-size: 11px;
    font-weight: 700;
    color: var(--text-muted);
    text-transform: uppercase;
    display: block;
    margin-bottom: 8px;
  }

  .no-data {
    font-size: 12px;
    color: var(--text-muted);
    font-style: italic;
  }

  .mini-answers-list {
    display: flex;
    flex-direction: column;
    gap: 10px;
  }

  .mini-answer-item {
    background-color: hsla(var(--hue-neutral), 30%, 15%, 0.3);
    padding: 8px 12px;
    border-radius: 6px;
  }

  .role-badge {
    font-size: 10px;
    font-weight: 700;
    color: var(--primary-color);
    background-color: hsla(var(--hue-primary), 80%, 58%, 0.1);
    padding: 2px 6px;
    border-radius: 4px;
    display: inline-block;
    margin-bottom: 4px;
  }

  .answer-text {
    font-size: 12px;
    color: var(--text-main);
    line-height: 1.3;
    overflow: hidden;
    text-overflow: ellipsis;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
  }

  /* Tabla de Alertas */
  .alerts-section {
    padding: 24px;
    border-radius: 12px;
    border-color: hsla(330, 85%, 55%, 0.15);
    margin-bottom: 36px;
  }

  .empty-alerts {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 12px;
    padding: 24px;
    color: var(--text-muted);
  }

  .empty-icon {
    width: 36px;
    height: 36px;
    color: var(--success-color);
  }

  .table-responsive {
    width: 100%;
    overflow-x: auto;
  }

  .alerts-table {
    width: 100%;
    border-collapse: collapse;
    font-size: 13px;
    text-align: left;
  }

  .alerts-table th {
    padding: 12px;
    border-bottom: 1px solid var(--border-glass);
    color: var(--text-muted);
    font-weight: 600;
  }

  .alerts-table td {
    padding: 14px 12px;
    border-bottom: 1px solid var(--border-glass);
    vertical-align: middle;
  }

  .alert-code {
    background-color: hsla(var(--hue-accent), 85%, 55%, 0.1);
    color: var(--accent-color);
    padding: 4px 8px;
    border-radius: 6px;
    font-weight: 700;
  }

  .text-alert-val {
    color: var(--accent-color);
  }

  .badge-critical {
    font-size: 11px;
    font-weight: 700;
    color: white;
    background-color: var(--accent-color);
    padding: 4px 8px;
    border-radius: 4px;
  }

  /* Trazabilidad Grid de Respuestas */
  .answers-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
    gap: 20px;
    padding: 16px;
  }

  .answer-card {
    background-color: hsla(var(--hue-neutral), 30%, 15%, 0.2);
    border: 1px solid var(--border-glass);
    border-radius: 8px;
    padding: 16px;
    display: flex;
    flex-direction: column;
    gap: 12px;
  }

  .answer-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    border-bottom: 1px dashed var(--border-glass);
    padding-bottom: 8px;
  }

  .delete-response-btn:hover {
    color: #e11d48 !important;
    background: rgba(225, 29, 72, 0.1) !important;
  }

  .ans-code {
    font-size: 12px;
    font-weight: 700;
    color: var(--primary-color);
    background-color: hsla(var(--hue-primary), 80%, 58%, 0.1);
    padding: 2px 6px;
    border-radius: 4px;
  }

  .ans-role {
    font-size: 12px;
    font-weight: 600;
    color: var(--text-main);
  }

  .ans-question {
    font-size: 13px;
    color: var(--text-muted);
    font-weight: 500;
    line-height: 1.3;
  }

  .ans-value-box {
    background-color: hsla(var(--hue-neutral), 45%, 8%, 0.4);
    padding: 10px;
    border-radius: 6px;
    border: 1px solid var(--border-glass);
  }

  .box-label {
    font-size: 10px;
    color: var(--text-muted);
    display: block;
    margin-bottom: 4px;
  }

  .box-val {
    font-size: 13px;
    color: var(--text-main);
    font-weight: 600;
    line-height: 1.3;
  }

  .ans-footer {
    display: flex;
    justify-content: space-between;
    font-size: 11px;
    color: var(--text-muted);
  }

  .no-data-large {
    text-align: center;
    padding: 48px;
    color: var(--text-muted);
    font-style: italic;
  }

  /* Controles de Agrupación de Trazabilidad */
  .group-btn {
    border: none;
    padding: 6px 14px;
    border-radius: 6px;
    font-size: 12px;
    font-weight: 600;
    cursor: pointer;
    background: transparent;
    color: var(--text-muted);
    transition: all 0.2s ease;
  }

  .group-btn:hover {
    color: var(--text-main);
    background: rgba(28, 28, 26, 0.05);
  }

  .group-btn.active {
    background: var(--surface-card) !important;
    color: var(--primary-color) !important;
    box-shadow: 0 1px 4px rgba(0, 0, 0, 0.08);
  }

  .dark-theme .group-btn.active {
    box-shadow: 0 1px 4px rgba(0, 0, 0, 0.3);
  }

  /* Banners de Alerta POST */
  .banner-alert {
    padding: 16px 20px;
    border-radius: 12px;
    margin-bottom: 24px;
    display: flex;
    align-items: center;
    gap: 12px;
    border: 1px solid var(--border-glass);
    animation: slideDown 0.3s ease;
  }
  
  .success-banner {
    background-color: hsla(150, 80%, 40%, 0.15);
    border-color: hsla(150, 80%, 40%, 0.3);
    color: hsl(150, 80%, 45%);
  }

  .error-banner {
    background-color: hsla(0, 85%, 60%, 0.15);
    border-color: hsla(0, 85%, 60%, 0.3);
    color: var(--danger-color);
  }

  .banner-alert .icon {
    font-size: 20px;
  }

  .banner-alert .message {
    font-size: 14px;
    font-weight: 600;
  }

  /* Sección de Gestión de Cuestionarios */
  .management-section {
    padding: 24px;
    border-radius: 12px;
    margin-bottom: 36px;
  }

  .management-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 24px;
  }

  @media (max-width: 992px) {
    .management-grid {
      grid-template-columns: 1fr;
    }
  }

  .mgmt-card {
    display: flex;
    flex-direction: column;
    gap: 20px;
  }

  .mgmt-card-title {
    font-size: 18px;
    font-weight: 700;
    border-bottom: 1px solid var(--border-glass);
    padding-bottom: 10px;
  }

  .mgmt-form {
    display: flex;
    flex-direction: column;
    gap: 16px;
  }

  .form-group {
    display: flex;
    flex-direction: column;
    gap: 6px;
  }

  .form-group label {
    font-size: 12px;
    font-weight: 600;
    color: var(--text-muted);
  }

  .form-input {
    height: 40px;
    padding: 0 12px;
    border-radius: 8px;
    border: 1px solid var(--border-glass);
    background-color: hsla(var(--hue-neutral), 30%, 12%, 0.3);
    color: var(--text-main);
    font-family: inherit;
    font-size: 14px;
    outline: none;
    transition: border-color 0.2s ease;
  }

  .form-input:focus {
    border-color: var(--primary-color);
  }

  select.form-input {
    appearance: none;
    background-image: url("data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' width='24' height='24' viewBox='0 0 24 24' fill='none' stroke='white' stroke-width='2' stroke-linecap='round' stroke-linejoin='round'><polyline points='6 9 12 15 18 9'></polyline></svg>");
    background-repeat: no-repeat;
    background-position: right 10px center;
    background-size: 16px;
    padding-right: 32px;
  }

  .form-row-2 {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 16px;
  }

  .mgmt-btn-submit {
    height: 44px;
    border-radius: 8px;
    border: none;
    background: var(--primary-glow);
    color: white;
    font-size: 14px;
    font-weight: 700;
    cursor: pointer;
    box-shadow: 0 4px 10px hsla(var(--hue-primary), 80%, 58%, 0.2);
    transition: all 0.2s ease;
  }

  .mgmt-btn-submit:hover {
    transform: translateY(-1px);
    box-shadow: 0 6px 15px hsla(var(--hue-primary), 80%, 58%, 0.35);
  }

  /* Listado de Cuestionarios Existentes */
  .assignments-list-container {
    display: flex;
    flex-direction: column;
    gap: 12px;
    max-height: 400px;
    overflow-y: auto;
    padding-right: 4px;
  }

  .assignment-item {
    border-radius: 8px;
    border: 1px solid var(--border-glass);
    background-color: hsla(var(--hue-neutral), 30%, 15%, 0.15);
    overflow: hidden;
  }

  .edit-details summary {
    list-style: none;
    cursor: pointer;
    outline: none;
  }

  .edit-details summary::-webkit-details-marker {
    display: none;
  }

  .details-summary {
    padding: 14px 16px;
  }

  .summary-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 12px;
  }

  .summary-details {
    display: flex;
    flex-direction: column;
    gap: 2px;
  }

  .assignment-label {
    font-size: 15px;
    font-weight: 700;
  }

  .cuestionario-tag {
    font-size: 11px;
    color: var(--text-muted);
  }

  .summary-badges {
    display: flex;
    align-items: center;
    gap: 10px;
  }

  .type-badge {
    font-size: 10px;
    font-weight: 700;
    padding: 2px 6px;
    border-radius: 4px;
  }

  .type-badge.individual {
    background-color: hsla(var(--hue-primary), 80%, 58%, 0.15);
    color: var(--primary-color);
  }

  .type-badge.grupal {
    background-color: hsla(150, 80%, 40%, 0.15);
    color: var(--success-color);
  }

  .coverage-percentage {
    font-size: 12px;
    font-weight: 600;
    color: var(--text-muted);
  }

  .edit-panel {
    padding: 16px;
    border-top: 1px solid var(--border-glass);
    background-color: hsla(var(--hue-neutral), 35%, 10%, 0.2);
    display: flex;
    flex-direction: column;
    gap: 16px;
  }

  .edit-form {
    display: flex;
    flex-direction: column;
    gap: 12px;
  }

  .edit-actions {
    display: flex;
    justify-content: flex-end;
  }

  .btn-save {
    height: 36px;
    padding: 0 16px;
    border-radius: 6px;
    border: none;
    background-color: var(--primary-color);
    color: white;
    font-size: 13px;
    font-weight: 700;
    cursor: pointer;
    transition: background-color 0.2s ease;
  }

  .btn-save:hover {
    background-color: var(--primary-glow);
  }

  .link-info-row {
    display: flex;
    align-items: flex-end;
    gap: 12px;
    border-top: 1px dashed var(--border-glass);
    padding-top: 14px;
  }

  .url-box {
    flex: 1;
    display: flex;
    flex-direction: column;
    gap: 4px;
  }

  .url-label {
    font-size: 11px;
    color: var(--text-muted);
    font-weight: 600;
  }

  .url-text {
    height: 32px;
    padding: 0 10px;
    border-radius: 6px;
    border: 1px solid var(--border-glass);
    background-color: hsla(0, 0%, 0%, 0.2);
    color: var(--primary-color);
    font-family: monospace;
    font-size: 12px;
    outline: none;
    width: 100%;
  }

  .edit-actions {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 16px;
    margin-top: 8px;
  }

  .btn-preview-link {
    font-size: 13px;
    font-weight: 600;
    color: var(--primary-color);
    text-decoration: none;
    background-color: hsla(var(--hue-primary), 80%, 58%, 0.1);
    padding: 8px 16px;
    border-radius: 6px;
    transition: all 0.2s;
    border: 1px solid hsla(var(--hue-primary), 80%, 58%, 0.15);
    display: inline-flex;
    align-items: center;
    gap: 6px;
  }

  .btn-preview-link:hover {
    background-color: var(--primary-color);
    color: white;
    border-color: var(--primary-color);
  }

  .btn-delete {
    height: 32px;
    padding: 0 12px;
    border-radius: 6px;
    border: 1px solid var(--danger-color);
    background-color: transparent;
    color: var(--danger-color);
    font-size: 12px;
    font-weight: 600;
    cursor: pointer;
    transition: all 0.2s ease;
  }

  .btn-delete:hover {
    background-color: var(--danger-color);
    color: white;
  }

  /* Sección de Auditoría WiFi */
  .audit-section {
    padding: 24px;
    border-radius: 12px;
    margin-bottom: 36px;
  }

  .audit-intro {
    font-size: 14px;
    color: var(--text-muted);
    margin-bottom: 20px;
    line-height: 1.5;
  }

  .empty-audit {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 12px;
    padding: 24px;
    color: var(--text-muted);
    text-align: center;
  }

  .audit-table {
    width: 100%;
    border-collapse: collapse;
    font-size: 13px;
    text-align: left;
  }

  .audit-table th {
    padding: 12px;
    border-bottom: 1px solid var(--border-glass);
    color: var(--text-muted);
    font-weight: 600;
  }

  .audit-table td {
    padding: 14px 12px;
    border-bottom: 1px solid var(--border-glass);
    vertical-align: middle;
  }

  .alert-row {
    background-color: hsla(0, 85%, 60%, 0.03);
  }

  .device-code {
    background-color: hsla(var(--hue-neutral), 30%, 15%, 0.4);
    padding: 4px 8px;
    border-radius: 6px;
    color: var(--text-main);
    font-family: monospace;
  }

  .alert-subjects {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
  }

  .subject-badge {
    font-size: 11px;
    font-weight: 700;
    color: var(--accent-color);
    background-color: hsla(var(--hue-accent), 85%, 55%, 0.1);
    padding: 2px 6px;
    border-radius: 4px;
  }

  .badge-fraud {
    font-size: 11px;
    font-weight: 700;
    color: white;
    background-color: var(--danger-color);
    padding: 4px 8px;
    border-radius: 4px;
  }

  @keyframes slideDown {
    from {
      transform: translateY(-10px);
      opacity: 0;
    }
    to {
      transform: translateY(0);
      opacity: 1;
    }
  }

  .interactive-sidebar-link {
    cursor: pointer;
    transition: all 0.2s ease;
  }

  .interactive-sidebar-link:hover {
    background-color: hsla(var(--hue-primary), 80%, 58%, 0.15);
    transform: translateX(4px);
    color: var(--primary-color) !important;
  }

  /* Animación de destello glow premium */
  .glow-highlight {
    border-color: var(--primary-color) !important;
    box-shadow: 0 0 20px hsla(var(--hue-primary), 80%, 58%, 0.35) !important;
    background-color: hsla(var(--hue-primary), 80%, 58%, 0.08) !important;
    transition: all 0.4s ease;
  }


  /* ===== RESPONSIVE: TABLETS (≤1150px) ===== */
  @media (max-width: 1150px) {
    .top-nav-bar {
      flex-direction: column;
      height: auto;
      padding: 10px 16px;
      gap: 8px;
    }

    .logo-area {
      width: 100%;
      justify-content: center;
    }

    .logo-area .logo-txt {
      font-size: 15px;
    }

    .logo-badge {
      display: none;
    }

    .stepper-wrapper {
      width: 100%;
      margin: 0;
      overflow-x: auto;
      -webkit-overflow-scrolling: touch;
      scrollbar-width: none;
      -ms-overflow-style: none;
    }

    .step-btn {
      padding: 0 10px;
      font-size: 13px;
      gap: 5px;
    }

    .step-num {
      font-size: 13px;
    }

    .step-label {
      font-size: 12px;
    }

    .step-divider {
      height: 16px;
    }

    .main-content {
      padding: 24px 16px;
    }

    .progress-info {
      display: none;
    }

    .header-actions .btn-preview-link {
      display: none;
    }

    .drawer-panel {
      width: 85vw !important;
    }
  }

  /* ===== RESPONSIVE: MEDIUM TABLETS & LANDSCAPE (≤1024px) ===== */
  @media (max-width: 1024px) {
    /* Grid overrides: stack all two-column grids */
    .layout-grid-sidebar,
    .layout-grid-roles,
    .layout-grid-builder,
    .layout-grid-compare,
    .layout-grid-double {
      grid-template-columns: 1fr !important;
    }

    /* KPI grid stacking */
    .kpi-grid {
      grid-template-columns: 1fr !important;
    }

    /* Form inputs full-width */
    .form-input,
    .form-select,
    select.form-input {
      width: 100% !important;
    }

    /* Inline dimension forms */
    .dim-edit-inline-form {
      flex-direction: column;
    }

    /* Question builder: stack side-by-side columns */
    .question-builder-layout {
      flex-direction: column !important;
    }
  }

  /* ===== RESPONSIVE: MÓVILES (≤640px) ===== */
  @media (max-width: 640px) {
    .top-nav-bar {
      flex-wrap: wrap;
      height: auto;
      padding: 10px 12px;
      gap: 8px;
    }

    .logo-area {
      width: 100%;
      justify-content: center;
    }

    .logo-area .logo-txt {
      font-size: 14px;
    }

    .stepper-wrapper {
      width: 100%;
      margin: 0;
      overflow-x: auto;
      -webkit-overflow-scrolling: touch;
      height: auto;
    }

    .stepper {
      height: auto;
      gap: 0;
      min-width: max-content;
      padding: 4px 0;
    }

    .step-btn {
      flex-direction: column;
      padding: 6px 10px;
      font-size: 11px;
      gap: 2px;
      height: auto;
      border-bottom-width: 2px;
    }

    .step-num {
      font-size: 12px;
    }

    .step-label {
      font-size: 10px;
    }

    .step-divider {
      display: none;
    }

    .header-actions {
      display: none !important;
    }

    .main-content {
      padding: 16px 12px;
    }

    .main-header {
      flex-direction: column !important;
      align-items: flex-start !important;
      gap: 12px;
    }

    .main-title {
      font-size: 20px !important;
    }

    .section-heading {
      font-size: 18px !important;
    }

    /* Drawer: full-width on mobile */
    .drawer-panel {
      width: 100vw !important;
    }

    .drawer-kpis {
      grid-template-columns: 1fr !important;
    }

    /* Tables: horizontal scroll on mobile */
    .table-responsive {
      overflow-x: auto;
      -webkit-overflow-scrolling: touch;
    }

    .control-table {
