            <div class="step-divider"></div>
            
            <!-- Etapa 3: Roles y Preguntas -->
            <button class="step-btn" data-step="roles" disabled={!activeHitoId}>
              <span class="step-num">③</span>
              <span class="step-label">Roles y Preguntas</span>
              <span class="step-indicator count">{cuestionarios.length}</span>
            </button>
            <div class="step-divider"></div>
            
            <!-- Etapa 4: Lanzamiento -->
            <button class="step-btn" data-step="lanzamiento" disabled={!activeHitoId}>
              <span class="step-num">④</span>
              <span class="step-label">Lanzamiento</span>
              <span class="step-indicator alert-badge">{asignaciones.length > 0 ? '✓' : '⚠'}</span>
            </button>
            <div class="step-divider"></div>
            
            <!-- Etapa 5: Resultados -->
            <button class="step-btn" data-step="resultados" disabled={!activeHitoId}>
              <span class="step-num">⑤</span>
              <span class="step-label">Resultados</span>
            </button>
          </div>
        </div>

        <div class="header-actions" style="display: flex; align-items: center; gap: 16px;">
          {activeHitoId && (
            <div class="progress-info">
              <span class="progress-percent">Configuración {configProgress}%</span>
              <div class="progress-bar-small">
                <div class="progress-fill" style={`width: ${configProgress}%`}></div>
              </div>
